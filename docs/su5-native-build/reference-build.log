info: YM/SU5/Selected/Sustain.lean:173:0: YM.CF.Buffered.Afterglow.Tower.Selected.selection_on_satin : ∀ (ε η : ℝ),
  0 < η →
    ∃ P l,
      ε < P.x ∧
        P.d ≤ η ∧
          P.nominated (YM.CF.VolumeCape.Dream.Nimbus l) ∧
            ∃ (H : Real.exp 1 ≤ P.x),
              ∃ Y a b I E,
                ∃ (V : YM.CF.Buffered.Afterglow.Journey.Universal Y H a b I E),
                  ∃ G q d w s c A',
                    YM.CF.Buffered.Afterglow.Tower.Selected.Issued Y H V ⋯ ⋯ 0 false (c 0) A' ∧
                      (∀ᵐ (x : A'.X) ∂A'.μ,
                          YM.CF.Buffered.Afterglow.Tower.Selected.Victory Y H V ⋯ ⋯ false 0 (c 0) (A'.character x)) ∧
                        (∀
                            (F :
                              YM.CF.Buffered.Afterglow.Tower.Selected.Marks (YM.CF.Buffered.Afterglow.Journey.tent Y H)
                                false)
                            (j : ℕ),
                            ∫ (i : A'.X),
                                YM.CF.Buffered.Afterglow.Tower.Selected.response Y H V j ⋯ ⋯ 0 false (c 0)
                                  (A'.character i) F ∂A'.μ =
                              E j ↑F) ∧
                          ∀ (z : YM.CF.SU.Slot) (o : YM.Lattice.Cover),
                            ∃ F x,
                              YM.CF.Buffered.Afterglow.Tower.Selected.Survivor Y H V s ⋯ ⋯ 0 (c 0) z o q d
                                  (YM.CF.Pannier.Chancel.Sen o (YM.CF.Pannier.Chancel.payout d q w)) F
                                  (A'.character x) ∧
                                ∀ (k : YM.Axis),
                                  YM.CF.Buffered.Afterglow.Tower.Selected.Survivor Y H V s ⋯ ⋯ k (c k) z o q d
                                    (YM.CF.Pannier.Chancel.Sen o (YM.CF.Pannier.Chancel.payout d q w)) F
                                    (YM.CF.Buffered.Afterglow.Tower.Selected.displacement Y H V ⋯ ⋯ 0 false (c 0)
                                      (A'.character x) k (c k))
