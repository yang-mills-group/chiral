                  (ζ.E (whenly Y₀ s (1 + t))) (d ((markedActor Y H V Q Qc j false (C j) F s) y))⟫_ℂ =
                phaseRead Y H V Q Qc j (C j) (escort Y H V Q Qc 3 false (C 3) j (C j) χ) s (f * (T j↑t) g)) →
            (∀ (u t : ℕ) (p : s ≤ u),
                ⟪d ((markedActor Y H V Q Qc j false (C j) F s) x),
