  {N0 : ℕ} {T : Month x 1 6 2 N0 V W} {delay : ℝ} {P : Prescription R B} (H : Service V U W J q h D C R0 P N0 delay)
  (G : Morn K) (Q : Diary) (sk : G.After R) (Lq : ShelfTh G Q R0 D C J q h P N0 delay) (hc : 1 ≤ h) :
  ∀ᶠ (j : ℕ) in atTop,
    ∀ (m : Side) (z : ℕ),
      j < z →
        ∀ (ht' : T.q ≤ ↑m) (S : Cape m B R.L) (ρ F : ℕ → ℝ) (s : Parcel J q h D C R0 T ht' S ρ F z),
          Prepared P delay s →
            have A := s.gram j;
            have U0 := s.gram (j + 1);
            have m' := thinAllot G.Mult R (hat R.L x j);
            have Tq := 3 * dleaf R.L (hat R.L x j);
            have q0 := Tq + m';
