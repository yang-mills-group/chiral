  (z : ℕ → ℕ) :
  ∃ P K,
    uniform P K Y L M ∧
      P.Roster ∧
        TintCommercial n_ X P.par ∧
          (∃ Pay kC Γ Tξ,
              0 ≤ Pay ∧
                0 ≤ kC ∧
                  0 ≤ Γ ∧
                    Taxi.DayT 6 Γ ∧
                      X P.par.K P.par.L Pay kC Γ Tξ ≤ ↑P.par.R.L ∧
                        InkCover P.par.J Chi.canonical P.par.h P.par.N0 Pay kC Γ Tξ n_ P.par.P ∧
                          Feather P.par.J Chi.canonical P.par.h P.par.N0 Pay kC Γ Tξ n_ P.par.P) ∧
            ∃ c r x,
              z ≤ r ∧
                ∃ J,
                  P.Experiment K c r x J ∧
                    P.Transmission x c r ∧
                      ∀ (U V : Doorway) (order : Orders),
                        U.Later V order 0 →
                          ∀ᶠ (i : ℕ) in atTop,
                            ∃ a F G,
                              Dose.Normalized F ∧
                                Dose.Normalized G ∧
                                  tsupport F.val ⊆ U.invites ∧
                                    tsupport G.val ⊆ V.invites ∧
                                      P.ReturnsSix x (c i) (r i) a F G ∧ P.FixedSatinReadings K x (c i) (r i) a F G
