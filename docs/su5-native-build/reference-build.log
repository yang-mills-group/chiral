        YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H)}
  {a b : ℕ → ℕ} (Q : YM.CF.Buffered.Afterglow.Tower.Coherent Y H D a b)
  (Qc : YM.CF.Buffered.Afterglow.Tower.SlabMark.Clipped Y H (i ∘ a) (k ∘ b)) (j : YM.Axis)
  (C : YM.CF.Buffered.Afterglow.Tower.Arena Y H ⋯ j 0 false) {s : ℕ}
  {F : YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H)}
  {O : Set YM.CF.Buffered.Afterglow.Tapestry.RSpace} {m : ℕ} {u : Fin m → YM.Lattice.Cover}
  {T : Finset YM.Lattice.Cover} {w : YM.CF.SU.Slot} {b' : ℝ} (χ : CapCharacter Y H V Q Qc j false C),
  PhysicalTexture Y H F w s T u O b' →
    ∀ {e : ℝ},
      0 ≤ e →
        e < ‖phaseRead Y H V Q Qc j C χ s F‖ →
          ∀ {z : ℕ} {δ c : ℝ},
            Placement Y H j T s z δ c →
              ¬pairFactors j (YM.CF.Buffered.Afterglow.Journey.tent Y H) (↑z) T (YM.CF.Window.family w) u
                    (phaseRead Y H V Q Qc j C χ s) ∧
                ∀ (n : ℕ),
                  have x :=
