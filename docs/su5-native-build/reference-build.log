  {E : ℕ → Family K → ℂ} {V : Universal Y H i k I E} {D : ℕ → Family K → Family K} {a b : ℕ → ℕ}
  {Q : Coherent Y H D a b} {Qc : Clipped Y H (i ∘ a) (k ∘ b)} {C : (j : Axis) → Arena Y H ⋯ j 0 false}
  {Ψ : Horizon Y H V Q Qc 3 false (C 3)} {X : Tapestry.Rack Λ l} {Z₀ : Clay Λ l} {eX : Exhibition Y H i k I E X Z₀}
  {A : Mezz} {b' v' w' : ℕ} {C₁ δ ε Γ : ℝ} {G F : Coast → Wq A.marks} {Δ : Delay Y H b' v' δ Γ C₁ ε A w' G F}
  {s n n' : ℕ} {L : (W : Window.Family) → A.Sermon K W} {q d w : ℕ} {X' : SU.Slot → Family K} {x : Ψ.X},
  Law Y H V Q Qc 3 false (C 3) Ψ →
    extremeJoint Y H Q false (marked Y H V Q Qc 3 false (C 3) (Ψ.character x)) →
      printedHere Λ l s A.Broad (Tapestry.cabin ↑n') →
        (∀ (W : Window.Family),
            ‖E s (mirror K 3 0 ↑(Sermon.solitude A K ⋯ (L W)) * ↑(Sermon.solitude A K ⋯ (L W)))‖ ≤
              3 * Real.exp (1 - Γ)) →
          (∀ (W : Window.Family), Guild.Fulfill Y H V Q Qc C s (Ψ.character x) ⋯ (L W) ↑n') →
            (∀ (a_1 : Axis),
                ∃ U',
