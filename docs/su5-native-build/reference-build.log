info: YM/SU5/Selected/Elected.lean:112:0: YM.CF.Buffered.Afterglow.Tower.VacuumSelection.lodestar_purchase : ∀ (ε η : ℝ),
  0 < η →
    ∀ (o : YM.Lattice.Cover) (j : YM.Axis),
      ∃ P,
        P.par.nominated (YM.CF.VolumeCape.Dream.Nimbus P.width) ∧
          ε < P.par.x ∧
            P.par.d ≤ η ∧
              ∃ R,
                YM.CF.Buffered.Afterglow.Tapestry.SeasonCert P.run ⋯ ⋯ ∧
                  ∃ q d w Z C,
                    YM.CF.Py.Rate.LocalLimit.Papal.Cornet P.run ⋯ q d w C Z ∧
                      ∀ (z : YM.CF.SU.Slot),
                        ∀ᶠ (s : ℕ) in Filter.atTop,
                          have S := YM.CF.Pannier.Chancel.Sen o (YM.CF.Pannier.Chancel.payout d q w);
                          have b := YM.CF.Pannier.Chancel.booty o d q;
                          ∃ F f N,
                            ↑f = ↑F ∧
                              YM.CF.Buffered.Afterglow.Tower.FixedProbe.AnchorGap s b S ∧
                                YM.CF.Buffered.Afterglow.Tower.FixedProbe.Carries P.run ⋯ ⋯ s P.projection F S N ∧
                                  ↑f ∈ YM.CF.Pannier.Chancel.Filigree P.calibration (YM.CF.Window.family z) b S ∧
                                    (∃ i y,
                                        YM.CF.Buffered.Lifted.nodeC y ∈ S ∧
                                          (∀ (t : Fin (q ^ 4)), y ≠ b t) ∧
                                            0 <
                                              dist
                                                (YM.CF.Buffered.Afterglow.Tapestry.addressG P.par s
                                                  (YM.CF.Buffered.Lifted.nodeC y))
                                                (YM.CF.Buffered.Afterglow.Tapestry.addressG P.par s
                                                  (YM.CF.Buffered.Lifted.nodeC (b i)))) ∧
                                      1 / 4 ≤ ‖P.E s ↑F‖ ∧
                                        ∃ u,
                                          P.LodestarStatus j u ∧
                                            ∀ (k : YM.Axis), P.Retained k s ((P.otherSpectrum j k) u) b S z f
