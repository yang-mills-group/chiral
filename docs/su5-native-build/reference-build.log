  {Q : Coherent Y H D a b} {Qc : Clipped Y H (i ∘ a) (k ∘ b)} {j : Axis} {C : Arena Y H ⋯ j 0 false} {s n : ℕ}
  {c k_1 : ℝ} {χ : Ch} {f g : Family K} {S T : Finset Cover},
  OrderedU Λ l (s + n) c (grate Λ l s) (volumeAround Λ l n S) (volumeAround Λ l n T) →
    (Sx n) (f * g) = (Sx n) f * (Sx n) g →
      k_1 < ‖E (s + n) ((Sx n) f * (Sx n) g)‖ →
        k_1 < ‖readχ χ (s + n) ((Sx n) f * (Sx n) g)‖ →
          (∀ (x y : observable K false),
              ↑x = (Sx n) f →
                ↑y = (Sx n) g →
                  E (s + n) ↑y = 0 ∧
                    readχ χ (s + n) ↑y = 0 ∧
                      (F₀(s + n)) y = 0 ∧
                        (N(s + n)) y = 0 ∧ (F₀(s + n)) (composed false x y) ≠ (F₀(s + n)) x * (F₀(s + n)) y) →
            (∃ x y,
                ↑x = (Sx n) f ∧
