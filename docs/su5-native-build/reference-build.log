info: SatinPP/Lantern.lean:58:0: structure YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.Chandelier (P : Spine) (x : P.Spectrum0 3)
  (w : ℒ → Prism) (V : (j : Axis) → List Axis → ℝ → (P.ColorHil j (P.advocate 3 x j)).space)
  (Y : ℒ → Spool (P.ManyF 3 (P.advocate 3 x 3))) (F U : SampleDose) : Prop
number of parameters: 7
fields:
  YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.Chandelier.gate : ∀ (m : ℒ → ℂ),
      fanSet m →
        ‖(guards (P.seasons 3 (P.advocate 3 x 3))) (ounce m (P.wave x V w false 1 F))‖ ≠ 0 ∧
          ‖(guards (P.seasons 3 (P.advocate 3 x 3))) (ounce m (P.wave x V w true 1 U))‖ ≠ 0
  YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.Chandelier.timelike : ∃ Q,
      ∃ (p : Feather (P.seasons 3 (P.advocate 3 x 3)) Q),
        let T := P.timeLike x Y F U Q p;
        Sea T ∧
          ReadsSix (T 1) ∧
            T 1 = oneBox (P.wave x V w false 1 F) (P.wave x V w true 1 U) Q ∧
              (∀ (d : ℝ) (u : 0 < d), T (sideways d) = P.MinkSplay x Y (puffup F u) (puffup U u) Q p) ∧
                ∀ (a b : ℝ),
                  0 ≤ a →
                    a < b →
                      ∃ d ∈ Set.Ioo a b,
                        ∃ (g : 0 < d),
                          ReadsSix (P.MinkAnswer x Y (puffup F g) (puffup U g)) ∧
                            ReadsSix (P.MinkSplay x Y (puffup F g) (puffup U g) Q p)
constructor:
  YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.Chandelier.mk {P : Spine} {x : P.Spectrum0 3} {w : ℒ → Prism}
    {V : (j : Axis) → List Axis → ℝ → (P.ColorHil j (P.advocate 3 x j)).space}
    {Y : ℒ → Spool (P.ManyF 3 (P.advocate 3 x 3))} {F U : SampleDose}
    (gate :
      ∀ (m : ℒ → ℂ),
        fanSet m →
          ‖(guards (P.seasons 3 (P.advocate 3 x 3))) (ounce m (P.wave x V w false 1 F))‖ ≠ 0 ∧
            ‖(guards (P.seasons 3 (P.advocate 3 x 3))) (ounce m (P.wave x V w true 1 U))‖ ≠ 0)
    (timelike :
      ∃ Q,
        ∃ (p : Feather (P.seasons 3 (P.advocate 3 x 3)) Q),
          let T := P.timeLike x Y F U Q p;
          Sea T ∧
            ReadsSix (T 1) ∧
              T 1 = oneBox (P.wave x V w false 1 F) (P.wave x V w true 1 U) Q ∧
                (∀ (d : ℝ) (u : 0 < d), T (sideways d) = P.MinkSplay x Y (puffup F u) (puffup U u) Q p) ∧
                  ∀ (a b : ℝ),
                    0 ≤ a →
                      a < b →
                        ∃ d ∈ Set.Ioo a b,
                          ∃ (g : 0 < d),
                            ReadsSix (P.MinkAnswer x Y (puffup F g) (puffup U g)) ∧
                              ReadsSix (P.MinkSplay x Y (puffup F g) (puffup U g) Q p)) :
    P.Chandelier x w V Y F U
