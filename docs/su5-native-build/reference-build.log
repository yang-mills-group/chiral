info: YM/CF/BPress/Wealth/Support.lean:26:0: theorem YM.CF.BPress.Wealth.GEM.plus : ∀ {G : Gauge} {s : Side} {f g : Config G s → ℝ} {S : Support s} {k t : ℝ},
  GEM S f k → GEM S g t → GEM S (fun i => f i + g i) (k + t) :=
fun {G} {s} {f g} {S} {k t} h p =>
  { zero := add_nonneg h.zero p.zero,
    price := fun x => LE.le.trans (abs_add_le (f x) (g x)) (add_le_add (h.price x) (p.price x)),
    meas := Measurable.add h.meas p.meas,
    loc := fun x x_1 e => congrArg₂ (fun x1 x2 => x1 + x2) (h.loc x x_1 e) (p.loc x x_1 e),
    inv := fun g_1 i => congrArg₂ (fun x1 x2 => x1 + x2) (h.inv g_1 i) (p.inv g_1 i) }
