info: SatinPP/Matinee.lean:79:0: def YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.Affirmed : Invoice → Prop :=
fun I =>
  ∃ P K c r x R i₀ F U,
    (∀ (i k : ℕ), (((P.run.voyage i).X (P.run.uv k)).gram 0).beta = P.par.x) ∧
      P.Experiment K c r x R ∧
        P.Transmission x c r ∧
          Dose.Normalized F ∧
            Dose.Normalized U ∧
              tsupport F.val ⊆ reviewEarlierBox.invites ∧
                tsupport U.val ⊆ reviewLaterBox.invites ∧
                  P.ReturnsSix x (c i₀) (r i₀) 0 F U ∧
                    P.FixedSatinReadings K x (c i₀) (r i₀) 0 F U ∧
                      ∃ A n w V g h,
                        ∃ (X : P.HandleWith x c r A n),
                          I P K c r x R i₀ F U A n w V g h X ∧
                            P.FullPrismLab x A c r n w V g h X 1 F U reviewEarlierBox reviewLaterBox (c i₀) (r i₀) K ∧
                              (∃ d,
                                  0 < d ∧
                                    LoudMargin (P.readPrism x V w 1 F U) d ∧
                                      ∀ᶠ (i : ℕ) in atTop,
                                        ∀ (t : ℕ), c (n i) ≤ t → LoudMargin (P.azurePrism x A c r n w F U i t) d) ∧
                                ((∀ᶠ (i : ℕ) in atTop,
                                      Tendsto (fun t => P.azurePrism x A c r n w F U i t) atTop
                                        (𝓝 (P.thinJournal x A c r n w X F U i))) ∧
                                    Tendsto (P.thinJournal x A c r n w X F U) atTop (𝓝 (P.readPrism x V w 1 F U))) ∧
                                  ∀ᶠ (i : ℕ) in atTop,
                                    ∀ (t : ℕ),
                                      c (n i) ≤ t →
                                        ∀ (a : Lead.Clan) (u : Hierarchy.Charm.W P.calibration),
                                          Hierarchy.LyraBill.Chiffon.Sesame.FlakeNight.Verne.GNative P.calibration u →
                                            ↑(P.prepared t (Apron.kiss P 3 (P.soldTrumpet A c r n w a i)) F) ≠ ↑u ∧
                                              ↑(P.prepared t (P.soldTrumpet A c r n w a i) U) ≠ ↑u
