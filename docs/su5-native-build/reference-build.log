  (F : observable K true) {q d w : ℕ} {z : SU.Slot} {o : Cover} {δ : ℝ},
  Between K j 0 (ruler Λ.block * ↑w) (plow K j (↑p) S) →
    0 < w →
      PhysicalHush s j (reflectedBox j 0 (plow K j (↑p) S)) (plow K j (↑p) S) δ →
        Survivor Y H V s Q Qt j C z o q d S F c →
