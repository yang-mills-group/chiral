info: Risa/Festival.lean:81:0: 'YM.Gleam.Luster.Risa.festival' depends on axioms: [propext, Classical.choice, Quot.sound]
info: Risa/Festival.lean:82:0: @festival : ∀ {c n : Side} {r : Ratio c n} {G : Gauge} {p : BudgetPoint} {q : Clip} {v t η C S w δ β κ ξ Λ v' ν : ℝ}
  {m : ℕ} {R : Rules G} {Z : PathData G} {H : Bed} {J : ChartRatio G} (B : Z.Bounds q η C S) (P : Attached H Z),
  Floor H q n δ w →
    LocalRatio J →
      ∀ {χ fuel Q0 b₁ b₀ y plumeU : ℝ} {Φ : Config G n → ℝ} {Q : Support c → Finset (Cell n) → Altar G n → ℝ},
        Envelope Φ →
          GaugeInvariant Φ →
            (∀ (A : Support c) (D : Finset (Cell n)), ContDiff ℝ 1 (Q A D)) →
              (∀ (A : Support c) (D : Finset (Cell n)) (x : Altar G n), |Q A D x| ≤ b₁) →
                (∀ (A : Support c) (D : Finset (Cell n)) (x : Altar G n), ‖fderiv ℝ (Q A D) x‖ ≤ b₀) →
                  (∀ (A : Support c) (D : Finset (Cell n)),
                      GradeLease B P p r m β v (Q0 + y * snags r m A D) v' A D Φ (Q A D)) →
                    Radiance J R q p (↑r.count) m β κ fuel v' ξ χ ν v Λ →
                      χ + ν ≤ β * (q.direct * p.threshold ^ 2 / 2) →
                        2 * (↑r.count + 1) < ↑n →
                          0 ≤ t →
                            0 < β →
                              0 ≤ C →
                                Odd ↑r.count →
                                  hallBill m ≤ ↑r.count / 2 →
                                    (∀ (i : Body 1 n), K (H.metric.acts n) i i ≤ t) →
                                      0 < δ →
                                        4 * descendCost J β t y * ↑↑r.count ^ 4 ≤ ξ →
                                          4 * descendCost J β t y * ↑(lusterBill (hallBill m)) ≤ χ →
                                            0 ≤ y →
                                              (∀ (A : Support c) (D : Finset (Cell n)),
                                                  plumeCost B P (Q A D) 1 ≤ plumeU) →
                                                ∫ (U : Config G n),
                                                    goods Z q p β κ fuel v' U * Real.exp (Φ U) ∂prior G n ≤
                                                  Real.exp
                                                    (Roof J β n H +
                                                                rentRoom r R q m p β v η C S Λ (descendCost J β t y) +
                                                              Q0 +
                                                            trend * b₀ ^ 2 * 1 ^ 2 +
                                                          plumeU +
                                                        Real.log 2 * ↑(Fintype.card (Site c)) +
                                                      Real.exp (-ν) * ↑(Fintype.card (Cell n)))
