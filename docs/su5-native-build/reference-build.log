info: GaugeFieldConstruction/Laps.lean:40:0: theorem YM.CF.Urn.link_l.{u_4, u_5} : ∀ {n : Type u_4} {m : Type u_5} [inst : LinearOrder n] [inst_1 : Fintype n]
  [inst_2 : LinearOrder m] [inst_3 : Fintype m] (b r t : Bool) (U : UNI n) (V : UNI m) (X X' : Matrix n m ℂ),
  X' = suburban b U V X →
    ∀ (i : n) (j : m),
      ∑ k, ↑(crib U r t) k i * cSignX (t ^^ r) (X' k j) = ∑ k, cSignX (b ^^ r) (cSignX t (X i k)) * ↑(crib V r t) j k :=
fun {n} {m} [LinearOrder n] [Fintype n] [LinearOrder m] [Fintype m] b r t U V X X' h i j =>
  Matrix.ext_iff.mpr (link_o b r t U V X X' h) i j
