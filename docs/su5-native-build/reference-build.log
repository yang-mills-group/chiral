info: Mussel/Glade.lean:72:0: def YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.Habitat.Hemlock.stage : {P : Spine} →
  (Z : Lead.Clan) →
    {s : ℕ} →
      {f : P.Test} →
        (Kpp : Sentry P s f) →
          (t : ℕ) →
            (u : Vantage) →
              (n : ℕ) →
                {a : Finset Cover} →
                  f ∈ bay P.calibration a true →
                    f ∈ enclave P.calibration →
                      P.calibration.ℓ < n →
                        Disjoint (P.pinFoot t (Hemlock.topArm t a)) (P.pinFoot t (Hemlock.wing Z Kpp t u n)) →
                          Broker.FrameZ P Z.2 t :=
fun {P} Z {s} {f} Kpp t u n {a} p b hn h =>
  { mainStem := P.conveying s (t - s) f, tailZ := P.issuing t (puppet P Z t n) (Hemlock.frost P s Kpp.w u t),
    S0 := Hemlock.topArm t a, T0 := Hemlock.wing Z Kpp t u n, mainPin := ⋯, tailPin := ⋯, clearF := h, tailSense := ⋯,
    mainColor := ⋯, tailColor := ⋯ }
