info: YM/CF/Appel/Font.lean:31:41: G : Gauge
c f : Side
S : StepData c f
T : Tube G S
A : Stores S
F : Forest S.ratio
k : S.Choices
V : Config G c
x K v d s : ℝ
q : Chi
Y : LinkArray G (Frozen A x F)
β : ℝ
h : 0 < β
hT : T.up.Bounds T.high s v K
z : Prices G (Active A x F)
he : Offset.b T x k A F q d Y V = blame T x V k (shots S x) A F q d Y
l : ℕ
M : Matrix (In x A F) (In x A F) ℝ := credW T A F k q d x Y l V
w : In x A F → ℝ := M *ᵥ z
g : ℝ := coupling β
u : In x A F → ℝ := liftN T x V k A F q d Y l
a : In x A F → ℝ := u + g • w
U : Config G f := landed x A F V Y a
R : Gaussian.Table (In x A F) := Rows.gram T x V k (shots S x) A F
L : Prices G (Active A x F) → ℝ := guide T x V k (shots S x) A F q d Y
⊢ (-β *
        averaged fun s =>
          (globe S).work T x (pull s 0 (landed x A F V Y (u + coupling β • w))) (choice s k) (pull s 0 V) -
            columns V x k T F A q d Y (u + coupling β • w) s (globe S)) -
      (averaged fun s => columns V x k T F A q d Y u s (globe S)) / coupling β ^ 2 =
    -β * (fee T x V k A U - L a) - L u / g ^ 2
