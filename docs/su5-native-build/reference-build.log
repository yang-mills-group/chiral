  (S' : OS.Semigroup H j) (x y : H.space) (t : ℝ≥0), x = y - (S'.E t) y → S'.orth x = 0 :=
fun {H} {j} S' x y t p =>
  Eq.mpr (id (congrArg (fun _a => S'.orth _a = 0) p))
    (Eq.mpr (id (congrArg (fun _a => _a = 0) (map_sub S'.orth y ((S'.E t) y))))
      (Eq.mpr (id (congrArg (fun _a => S'.orth y - _a = 0) (powerS S' y t)))
        (Eq.mpr (id (congrArg (fun _a => _a = 0) (sub_self (S'.orth y)))) (Eq.refl 0))))
