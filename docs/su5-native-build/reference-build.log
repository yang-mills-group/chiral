    Finset YM.Lattice.Cover →
      Finset YM.Lattice.Cover →
        Finset YM.Lattice.Cover → Finset YM.Lattice.Cover → ℕ → ℕ → ℕ → (YM.CF.Buffered.Family K → ℂ) → Prop :=
fun K W D X Y S r m n L =>
  ∀ (f : YM.CF.Buffered.Lifted.PairsC → ℂ) (x : YM.CF.Buffered.Family K),
    YM.CF.Buffered.Coeff false S f →
      Rubric.Row K W D X Y S r m n x → L (YM.CF.Buffered.scalar K f * x) = L (YM.CF.Buffered.scalar K f) * L x
info: YM/SU5/Selected/V.lean:43:0: @Guild.Radiant.mk : ∀ {Λ : YM.CF.Py.Rate.LocalLimit.Preparation} {l : ℕ}
  {Y : Λ.Course (YM.CF.VolumeCape.Dream.Nimbus l)} {H : Real.exp 1 ≤ Λ.x} {i k : ℕ → ℕ}
  {I : ℕ → YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) → ℕ → ℂ}
  {E : ℕ → YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) → ℂ}
  {V : YM.CF.Buffered.Afterglow.Journey.Universal Y H i k I E}
  {D :
    ℕ →
      YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) →
        YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H)}
  {a b : ℕ → ℕ} {Q : YM.CF.Buffered.Afterglow.Tower.Coherent Y H D a b} {Qc : Clipped Y H (i ∘ a) (k ∘ b)}
  {C : (j : YM.Axis) → YM.CF.Buffered.Afterglow.Tower.Arena Y H Q.circuit j 0 false} {s : ℕ} {X₀ : Mezz}
  {χ : CapCharacter Y H V Q Qc 3 false (C 3)} {e : X₀.Legate} {F : YM.CF.Window.Family}
  {Z : X₀.Sermon (YM.CF.Buffered.Afterglow.Journey.tent Y H) F} {s' : Finset X₀.Lot} {c : ℝ},
  Steered Y H V Q Qc C s e Z c s' →
    (∀ (v : YM.Axis),
        ¬Rubric.Challenged (YM.CF.Buffered.Afterglow.Journey.tent Y H) F X₀.Zumba (X₀.coast_b true) (X₀.coast_b false)
            X₀.Broad (10 * s'.card) (10 * s'.card) s'.card
            (phaseRead Y H V Q Qc v (C v) (escort Y H V Q Qc 3 false (C 3) v (C v) χ) s)) →
      (∀ (v : YM.Axis),
          Sermon.honey X₀ <
            ‖phaseRead Y H V Q Qc v (C v) (escort Y H V Q Qc 3 false (C 3) v (C v) χ) s
                ↑(Sermon.embrace X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) e Z s')‖) →
        (∃ i_1,
            Odd (Sermon.regCard X₀ s' i_1) ∧
              (∀ (v : YM.Axis),
                  Alight Y H V Q Qc v (C v) s c (grate Λ l s)
                    (↑(Sermon.stagD X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) e Z s' i_1))
                    (↑(Sermon.stagU X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) e Z s' i_1))
                    (Sermon.toyL X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) i_1)
                    (Sermon.toyR X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) i_1)) ∧
                ↑(Sermon.embrace X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) e Z s') =
                    ↑(Sermon.stagD X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) e Z s' i_1) *
                      ↑(Sermon.stagU X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) e Z s' i_1) ∧
                  ∀ (X : Birthplace Y H V Q Qc 3 false (C 3) (escort Y H V Q Qc 3 false (C 3) 3 (C 3) χ)),
                    ∃ x y,
                      ↑x =
                          YM.CF.Buffered.Afterglow.Tower.mirror (YM.CF.Buffered.Afterglow.Journey.tent Y H) 3 0
                            (relocate (YM.CF.Buffered.Afterglow.Journey.tent Y H) 3
                              (-Sermon.declination X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) i_1)
                              ↑(Sermon.stagD X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) e Z s' i_1)) ∧
                        ↑y =
                            relocate (YM.CF.Buffered.Afterglow.Journey.tent Y H) 3
                              (-Sermon.declination X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) i_1 - 1)
                              ↑(Sermon.stagU X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) e Z s' i_1) ∧
                          YM.CF.Buffered.InTest (YM.CF.Buffered.Afterglow.Journey.tent Y H) false
                              (YM.CF.Buffered.Afterglow.Tower.reflectedBox 3 0
                                (plow (YM.CF.Buffered.Afterglow.Journey.tent Y H) 3
                                  (-Sermon.declination X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) i_1)
                                  (Sermon.toyL X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) i_1)))
                              false ↑x ∧
                            YM.CF.Buffered.InTest (YM.CF.Buffered.Afterglow.Journey.tent Y H) false
                                (plow (YM.CF.Buffered.Afterglow.Journey.tent Y H) 3
                                  (-Sermon.declination X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) i_1 - 1)
                                  (Sermon.toyR X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) i_1))
                                false ↑y ∧
                              YM.CF.Buffered.Afterglow.Tapestry.Neutral (YM.CF.Buffered.Afterglow.Journey.tent Y H) ↑x ∧
                                YM.CF.Buffered.Afterglow.Tapestry.Neutral (YM.CF.Buffered.Afterglow.Journey.tent Y H)
                                    ↑y ∧
                                  inner ℂ (vacuum Y H V Q Qc 3 false (C 3) X)
                                        ((markedActor Y H V Q Qc 3 false (C 3) X s) x) =
                                      0 ∧
                                    inner ℂ (vacuum Y H V Q Qc 3 false (C 3) X)
                                          ((markedActor Y H V Q Qc 3 false (C 3) X s) y) =
                                        0 ∧
                                      inner ℂ ((markedActor Y H V Q Qc 3 false (C 3) X s) x)
                                          (((journey Y H V Q Qc 3 false (C 3) X).track
                                              (YM.CF.Buffered.Afterglow.Tower.MeshClock.whenly
                                                (YM.CF.Buffered.Afterglow.Tower.timeMesh Λ) s 1))
                                            ((markedActor Y H V Q Qc 3 false (C 3) X s) y)) =
                                        phaseRead Y H V Q Qc 3 (C 3) (escort Y H V Q Qc 3 false (C 3) 3 (C 3) χ) s
                                          ↑(Sermon.embrace X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) e Z s')) →
          Guild.Radiant Y H V Q Qc C s χ e Z s' c
info: YM/SU5/Selected/V.lean:44:0: @star_budget : ∀ {Λ : YM.CF.Py.Rate.LocalLimit.Preparation} {l : ℕ} (Y : Λ.Course (YM.CF.VolumeCape.Dream.Nimbus l))
  (H : Real.exp 1 ≤ Λ.x) {i k : ℕ → ℕ}
  {I : ℕ → YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) → ℕ → ℂ}
  {E : ℕ → YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) → ℂ}
  (V : YM.CF.Buffered.Afterglow.Journey.Universal Y H i k I E)
  {D :
    ℕ →
      YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) →
        YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H)}
  {a b : ℕ → ℕ} (Q : YM.CF.Buffered.Afterglow.Tower.Coherent Y H D a b) (Qc : Clipped Y H (i ∘ a) (k ∘ b))
  (C : (j : YM.Axis) → YM.CF.Buffered.Afterglow.Tower.Arena Y H Q.circuit j 0 false)
  (Ψ : Horizon Y H V Q Qc 3 false (C 3)),
  Law Y H V Q Qc 3 false (C 3) Ψ →
    ∀ {A : Mezz} {b' v' w' : ℕ} {C₁ δ ε Γ : ℝ} {G F : YM.CF.Crest.Airy.Coast → YM.CF.Crest.Airy.Wq A.marks}
      (Δ : Delay Y H b' v' δ Γ C₁ ε A w' G F) (s : ℕ) {W : YM.CF.Window.Family}
      (x : A.Sermon (YM.CF.Buffered.Afterglow.Journey.tent Y H) W) {D' : ℝ},
      ‖E s
              (YM.CF.Buffered.Afterglow.Tower.mirror (YM.CF.Buffered.Afterglow.Journey.tent Y H) 3 0
                  ↑(Sermon.solitude A (YM.CF.Buffered.Afterglow.Journey.tent Y H) (Delay.stationed Y H Δ) x) *
                ↑(Sermon.solitude A (YM.CF.Buffered.Afterglow.Journey.tent Y H) (Delay.stationed Y H Δ) x))‖ ≤
          D' →
        ‖E s ↑(Sermon.solitude A (YM.CF.Buffered.Afterglow.Journey.tent Y H) (Delay.stationed Y H Δ) x)‖ ^ 2 ≤ D' ∧
          ∫ (i_1 : Ψ.X), ‖marked Y H V Q Qc 3 false (C 3) (Ψ.character i_1) s (screen Y H Δ x)‖ ^ 2 ∂Ψ.μ ≤ D'
info: YM/SU5/Selected/V.lean:45:0: @Radiant.brisk : ∀ {Λ : YM.CF.Py.Rate.LocalLimit.Preparation} {l : ℕ} (Y : Λ.Course (YM.CF.VolumeCape.Dream.Nimbus l))
  (H : Real.exp 1 ≤ Λ.x) {i k : ℕ → ℕ}
  {I : ℕ → YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) → ℕ → ℂ}
  {E : ℕ → YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) → ℂ}
  (V : YM.CF.Buffered.Afterglow.Journey.Universal Y H i k I E)
  {D :
    ℕ →
      YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) →
        YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H)}
  {a b : ℕ → ℕ} (Q : YM.CF.Buffered.Afterglow.Tower.Coherent Y H D a b) (Qc : Clipped Y H (i ∘ a) (k ∘ b))
  (C : (j : YM.Axis) → YM.CF.Buffered.Afterglow.Tower.Arena Y H Q.circuit j 0 false) {ξ : ℝ} (s : ℕ) {X₀ : Mezz}
  (χ : CapCharacter Y H V Q Qc 3 false (C 3)) (e : X₀.Legate) {F : YM.CF.Window.Family}
  (Z : X₀.Sermon (YM.CF.Buffered.Afterglow.Journey.tent Y H) F)
  {X : Birthplace Y H V Q Qc 3 false (C 3) (escort Y H V Q Qc 3 false (C 3) 3 (C 3) χ)},
  LoneVac Y H V Q Qc 3 false (C 3) X →
    ∀ (s' : Finset X₀.Lot),
      Guild.Radiant Y H V Q Qc C s χ e Z s' ξ →
        ∀ (x y : ↥(YM.CF.Buffered.Afterglow.Tower.Field Y H s 3 0 false)),
          inner ℂ (vacuum Y H V Q Qc 3 false (C 3) X) ((markedActor Y H V Q Qc 3 false (C 3) X s) x) = 0 →
            inner ℂ (vacuum Y H V Q Qc 3 false (C 3) X) ((markedActor Y H V Q Qc 3 false (C 3) X s) y) = 0 →
              inner ℂ ((markedActor Y H V Q Qc 3 false (C 3) X s) x)
                    (((journey Y H V Q Qc 3 false (C 3) X).track
                        (YM.CF.Buffered.Afterglow.Tower.MeshClock.whenly (YM.CF.Buffered.Afterglow.Tower.timeMesh Λ) s
                          1))
                      ((markedActor Y H V Q Qc 3 false (C 3) X s) y)) =
                  phaseRead Y H V Q Qc 3 (C 3) (escort Y H V Q Qc 3 false (C 3) 3 (C 3) χ) s
                    ↑(Sermon.embrace X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) e Z s') →
                Sermon.honey X₀ <
                    ‖inner ℂ ((markedActor Y H V Q Qc 3 false (C 3) X s) x)
                        (((journey Y H V Q Qc 3 false (C 3) X).track
                            (YM.CF.Buffered.Afterglow.Tower.MeshClock.whenly (YM.CF.Buffered.Afterglow.Tower.timeMesh Λ)
                              s 1))
                          ((markedActor Y H V Q Qc 3 false (C 3) X s) y))‖ ∧
                  (markedActor Y H V Q Qc 3 false (C 3) X s) x ∉ bottom Y H V Q Qc 3 false (C 3) X ∧
                    (markedActor Y H V Q Qc 3 false (C 3) X s) y ∉ bottom Y H V Q Qc 3 false (C 3) X ∧
                      ((journey Y H V Q Qc 3 false (C 3) X).track
                              (YM.CF.Buffered.Afterglow.Tower.MeshClock.whenly
                                (YM.CF.Buffered.Afterglow.Tower.timeMesh Λ) s 1))
                            ((markedActor Y H V Q Qc 3 false (C 3) X s) x) ∉
                          bottom Y H V Q Qc 3 false (C 3) X ∧
                        ((journey Y H V Q Qc 3 false (C 3) X).track
                              (YM.CF.Buffered.Afterglow.Tower.MeshClock.whenly
                                (YM.CF.Buffered.Afterglow.Tower.timeMesh Λ) s 1))
                            ((markedActor Y H V Q Qc 3 false (C 3) X s) y) ∉
                          bottom Y H V Q Qc 3 false (C 3) X
info: YM/SU5/Selected/V.lean:46:0: @Radiant.product_priced : ∀ {Λ : YM.CF.Py.Rate.LocalLimit.Preparation} {l : ℕ}
  (Y : Λ.Course (YM.CF.VolumeCape.Dream.Nimbus l)) (H : Real.exp 1 ≤ Λ.x) {i k : ℕ → ℕ}
  {I : ℕ → YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) → ℕ → ℂ}
  {E : ℕ → YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) → ℂ}
  (V : YM.CF.Buffered.Afterglow.Journey.Universal Y H i k I E)
  {D :
    ℕ →
      YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) →
        YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H)}
  {a b : ℕ → ℕ} (Q : YM.CF.Buffered.Afterglow.Tower.Coherent Y H D a b) (Qc : Clipped Y H (i ∘ a) (k ∘ b))
  (C : (j : YM.Axis) → YM.CF.Buffered.Afterglow.Tower.Arena Y H Q.circuit j 0 false) {ξ : ℝ} (s : ℕ) {X₀ : Mezz}
  (χ : CapCharacter Y H V Q Qc 3 false (C 3)) (e : X₀.Legate) {F : YM.CF.Window.Family}
  (Z : X₀.Sermon (YM.CF.Buffered.Afterglow.Journey.tent Y H) F) (s' : Finset X₀.Lot),
  Guild.Radiant Y H V Q Qc C s χ e Z s' ξ →
    ∀ (v : YM.Axis) (n : ℕ),
      ∃ u w,
        ↑u = ↑(Sermon.Liturgy X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) e Z s' true) ∧
          ↑w = ↑(Sermon.Liturgy X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) e Z s' false) ∧
            have x := YM.CF.Buffered.Afterglow.Tower.Vacancy.upward Y H Q false u s n;
            have y := YM.CF.Buffered.Afterglow.Tower.Vacancy.upward Y H Q false w s n;
            YM.CF.Buffered.Afterglow.Tower.Vacancy.cap Y H V (s + n) Q Qc v false (C v) (composed false x y) ≠
              YM.CF.Buffered.Afterglow.Tower.Vacancy.cap Y H V (s + n) Q Qc v false (C v) x *
                YM.CF.Buffered.Afterglow.Tower.Vacancy.cap Y H V (s + n) Q Qc v false (C v) y
info: YM/SU5/Selected/V.lean:47:0: @grounded : ∀ {Λ : YM.CF.Py.Rate.LocalLimit.Preparation} {l : ℕ} (Y : Λ.Course (YM.CF.VolumeCape.Dream.Nimbus l))
