  {Q : Coherent Y H D a b} {Qc : Clipped Y H (i ∘ a) (k ∘ b)} {C : (j : Axis) → Arena Y H ⋯ j 0 false} {j : Axis}
  {s : ℕ} {χ : CapCharacter Y H V Q Qc 3 false (C 3)}
