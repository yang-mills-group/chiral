                (P.plotPanel x a (dotsB P a 2) (dotsB P a 4) (r t)).det ≠ 0 ∧
                  ∀ (j : CClan), 0 < (P.plotPanel x a (dotsB P a 2) (dotsB P a 4) (r t) j j).im
