  0 < c ∧ 0 < d ∧ d < t →
    c < ‖⟪x, (F.E d - F.E t) y⟫_ℂ‖ →
      c < ‖⟪(P F) x, (F.E d - F.E t) ((P F) y)⟫_ℂ‖ →
        (∀ (s : ℝ≥0),
            (F.E s) x ∉ F.ground ∧
              0 < ((spectralP F).diagonal ((F.E s) x)).real (Set.Ioi 0) ∧
                (F.E s) y ∉ F.ground ∧ 0 < ((spectralP F).diagonal ((F.E s) y)).real (Set.Ioi 0)) →
          (∀ (v : ℝ),
              ∃ u,
                u ≠ v ∧
                  c / 2 < ‖⟪x, (F.edge u - F.edge v) y⟫_ℂ‖ ∧ c / 2 < ‖⟪(P F) x, (F.edge u - F.edge v) ((P F) y)⟫_ℂ‖) →
            (∀ (z : Q'.space), Continuous fun i => (balcony F i) z) →
              AnalyticOnNhd ℂ (balcony F) {z | 0 < z.im} →
                (spectralP F).region (Set.Iio 0) = 0 →
                  (Alps.evolve F).Spectrum (spectralP F) →
                    (∀ (z : ℂ),
                        0 ≤ z.im →
                          ∀ (x : Q'.space),
                            ⟪x, (balcony F z) x⟫_ℂ =
                              ∫ (t : ℝ), Complex.exp (↑t * z * Complex.I) ∂(spectralP F).diagonal x) →
                      (spectralP F).region {0} = F.orth → Switch Q' F x y d t c
