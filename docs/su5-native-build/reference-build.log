info: YM/SU5/Selected/Generations.lean:108:0: YM.CF.Buffered.Afterglow.Tower.Selected.single_winemaker : ∀ (ε η : ℝ),
  0 < η →
    ∀ (U : YM.CF.Py.Rate.LocalLimit.Supplier),
      ∃ P l Z₁,
        ε < P.x ∧
          P.d ≤ η ∧
            P.nominated (YM.CF.VolumeCape.Dream.Nimbus l) ∧
              YM.CF.Py.Rate.LocalLimit.decorate U P l Z₁ ≤ P.h ∧
                ∃ (H : Real.exp 1 ≤ P.x),
                  ∃ Y a b I E,
                    ∃ (V : YM.CF.Buffered.Afterglow.Journey.Universal Y H a b I E),
                      ∃ R q d w s C c A',
                        have o := YM.CF.Pannier.Chancel.grain (YM.CF.Pannier.Chancel.payout d q w);
                        have S := YM.CF.Pannier.Chancel.Sen o (YM.CF.Pannier.Chancel.payout d q w);
                        YM.CF.Py.Rate.LocalLimit.Papal.Korn Y H q d w C Z₁ ∧
                          YM.CF.Buffered.Afterglow.Tower.Selected.Issued Y H V ⋯ ⋯ 0 false (c 0) A' ∧
                            (∀
                                (F :
                                  YM.CF.Buffered.Afterglow.Tower.Selected.Marks
                                    (YM.CF.Buffered.Afterglow.Journey.tent Y H) false)
                                (j : ℕ),
                                ∫ (i : A'.X),
                                    YM.CF.Buffered.Afterglow.Tower.Selected.response Y H V j ⋯ ⋯ 0 false (c 0)
                                      (A'.character i) F ∂A'.μ =
                                  E j ↑F) ∧
                              ∃ F x,
                                ∀ (z : YM.CF.SU.Slot),
                                  YM.CF.Buffered.Afterglow.Tower.Selected.ThresholdInteraction Y H V s ⋯ ⋯ 0 (c 0) S
                                      (A'.character x) (F z) z o q d ∧
                                    ∀ (k : YM.Axis),
                                      YM.CF.Buffered.Afterglow.Tower.Selected.ThresholdInteraction Y H V s ⋯ ⋯ k (c k) S
                                        (YM.CF.Buffered.Afterglow.Tower.Selected.displacement Y H V ⋯ ⋯ 0 false (c 0)
                                          (A'.character x) k (c k))
                                        (F z) z o q d
