info: YM/SU5/Selected/Cor/Coterie.lean:82:0: constructor YM.CF.Buffered.Afterglow.Tower.Selection.Fern.Guild.Steered.mk : ∀ {Λ : Preparation} {l : ℕ}
  {Y : Λ.Course (VolumeCape.Dream.Nimbus l)} {H : Real.exp 1 ≤ Λ.x} {i k : ℕ → ℕ} {I : ℕ → Family K → ℕ → ℂ}
  {E : ℕ → Family K → ℂ} {V : Universal Y H i k I E} {D : ℕ → Family K → Family K} {a b : ℕ → ℕ}
  {Q : Coherent Y H D a b} {Qc : Clipped Y H (i ∘ a) (k ∘ b)} {C : (j : Axis) → Arena Y H ⋯ j 0 false} {s : ℕ}
  {X₀ : Mezz} {e : X₀.Legate} {F : Window.Family} {Z : X₀.Sermon K F} {c : ℝ} {s' : Finset X₀.Lot},
  Odd #s' →
    ↑(N s') ∈ Rubric.Marble K F X₀.Zumba (X₀.coast_b true) (X₀.coast_b false) X₀.Broad (10 * #s') (10 * #s') #s' →
      InTest K false X₀.Broad false ↑(N s') ∧ Neutral K ↑(N s') →
        ↑(N s') = ↑(Λ₁ s' true) * ↑(Λ₁ s' false) →
          (∀ (v : Axis),
              Alight Y H V Q Qc v (C v) s c (grate Λ l s) (↑(Λ₁ s' true)) (↑(Λ₁ s' false)) (X₀.coast_b true)
                (X₀.coast_b false)) →
            (∃ i_1,
                Odd (regCard X₀ s' i_1) ∧
                  ↑(N s') = ↑(D₀ s' i_1) * ↑(U s' i_1) ∧
                    (∀ (v : Axis),
                        Alight Y H V Q Qc v (C v) s c (grate Λ l s) (↑(D₀ s' i_1)) (↑(U s' i_1)) (c₀ i_1) (c₁ i_1)) ∧
                      (∀ x ∈ c₀ i_1, x 3 + ↑K.ℓ ≤ R * d i_1) ∧ ∀ x ∈ c₁ i_1, R * d i_1 + R + ↑K.ℓ ≤ x 3) →
              Steered Y H V Q Qc C s e Z c s'
info: YM/SU5/Selected/Cor/Coterie.lean:112:0: constructor YM.CF.Buffered.Afterglow.Tower.Selection.Fern.Guild.Radiant.mk : ∀ {Λ : Preparation} {l : ℕ}
  {Y : Λ.Course (VolumeCape.Dream.Nimbus l)} {H : Real.exp 1 ≤ Λ.x} {i k : ℕ → ℕ} {I : ℕ → Family K → ℕ → ℂ}
  {E : ℕ → Family K → ℂ} {V : Universal Y H i k I E} {D : ℕ → Family K → Family K} {a b : ℕ → ℕ}
  {Q : Coherent Y H D a b} {Qc : Clipped Y H (i ∘ a) (k ∘ b)} {C : (j : Axis) → Arena Y H ⋯ j 0 false} {s : ℕ}
  {X₀ : Mezz} {χ : CapCharacter Y H V Q Qc 3 false (C 3)} {e : X₀.Legate} {F : Window.Family} {Z : X₀.Sermon K F}
  {s' : Finset X₀.Lot} {c : ℝ},
  Steered Y H V Q Qc C s e Z c s' →
    (∀ (v : Axis),
        ¬Rubric.Challenged K F X₀.Zumba (X₀.coast_b true) (X₀.coast_b false) X₀.Broad (10 * #s') (10 * #s') (#s')
            (phaseRead Y H V Q Qc v (C v) (escort Y H V Q Qc 3 false (C 3) v (C v) χ) s)) →
      (∀ (v : Axis), β < ‖phaseRead Y H V Q Qc v (C v) (escort Y H V Q Qc 3 false (C 3) v (C v) χ) s ↑(N s')‖) →
        (∃ i_1,
            Odd (regCard X₀ s' i_1) ∧
              (∀ (v : Axis),
                  Alight Y H V Q Qc v (C v) s c (grate Λ l s) (↑(D₀ s' i_1)) (↑(U s' i_1)) (c₀ i_1) (c₁ i_1)) ∧
                ↑(N s') = ↑(D₀ s' i_1) * ↑(U s' i_1) ∧
                  ∀ (X : Birthplace Y H V Q Qc 3 false (C 3) (escort Y H V Q Qc 3 false (C 3) 3 (C 3) χ)),
                    ∃ x y,
                      ↑x = mirror K 3 0 (relocate K 3 (-d i_1) ↑(D₀ s' i_1)) ∧
                        ↑y = relocate K 3 (-d i_1 - 1) ↑(U s' i_1) ∧
                          InTest K false (reflectedBox 3 0 (plow K 3 (-d i_1) (c₀ i_1))) false ↑x ∧
                            InTest K false (plow K 3 (-d i_1 - 1) (c₁ i_1)) false ↑y ∧
                              Neutral K ↑x ∧
                                Neutral K ↑y ∧
                                  ⟪vacuum Y H V Q Qc 3 false (C 3) X, (markedActor Y H V Q Qc 3 false (C 3) X s) x⟫_ℂ =
                                      0 ∧
                                    ⟪vacuum Y H V Q Qc 3 false (C 3) X,
                                          (markedActor Y H V Q Qc 3 false (C 3) X s) y⟫_ℂ =
                                        0 ∧
                                      ⟪(markedActor Y H V Q Qc 3 false (C 3) X s) x,
                                          ((arc X).track T) ((markedActor Y H V Q Qc 3 false (C 3) X s) y)⟫_ℂ =
                                        phaseRead Y H V Q Qc 3 (C 3) (escort Y H V Q Qc 3 false (C 3) 3 (C 3) χ) s
                                          ↑(N s')) →
          Radiant Y H V Q Qc C s χ e Z s' c
info: YM/SU5/Selected/Cor/Coterie.lean:131:0: constructor YM.CF.Buffered.Afterglow.Tower.Selection.Fern.Guild.Fulfill.mk : ∀ {Λ : Preparation} {l : ℕ}
  {Y : Λ.Course (VolumeCape.Dream.Nimbus l)} {H : Real.exp 1 ≤ Λ.x} {i k : ℕ → ℕ} {I : ℕ → Family K → ℕ → ℂ}
  {E : ℕ → Family K → ℂ} {V : Universal Y H i k I E} {D : ℕ → Family K → Family K} {a b : ℕ → ℕ}
  {Q : Coherent Y H D a b} {Qc : Clipped Y H (i ∘ a) (k ∘ b)} {C : (j : Axis) → Arena Y H ⋯ j 0 false} {s : ℕ}
  {X₀ : Mezz} {χ : CapCharacter Y H V Q Qc 3 false (C 3)} {e : X₀.Legate} {F : Window.Family} {Z : X₀.Sermon K F}
  {c : ℝ},
  InTest K false X₀.Broad false (1 - ↑H₀) ∧ Neutral K (1 - ↑H₀) →
    (1 / 2 < ‖E s (1 - ↑H₀)‖ ∧
        ∀ (v : Axis), 1 / 2 < ‖phaseRead Y H V Q Qc v (C v) (escort Y H V Q Qc 3 false (C 3) v (C v) χ) s (1 - ↑H₀)‖) →
      (∀ r < X₀.vowP, ∀ (Y' : Finset X₀.Lot), #Y' = Stencil.load r → Steered Y H V Q Qc C s e Z c Y') →
        (∃ r Y',
            r < X₀.vowP ∧
              #Y' = Stencil.load r ∧
                β < ‖E s ↑(N Y')‖ ∧
                  ¬Rubric.Challenged K F X₀.Zumba (X₀.coast_b true) (X₀.coast_b false) X₀.Broad (10 * #Y') (10 * #Y')
                      (#Y') (E s)) →
          (∃ r Y', r < X₀.vowP ∧ #Y' = Stencil.load r ∧ Radiant Y H V Q Qc C s χ e Z Y' c) →
            Fulfill Y H V Q Qc C s χ e Z c
