info: SatinSixCompatibility.lean:84:0: reviewSixPhysicalGrid : ∀ (P : Spine) (K : P.Register) (x : P.Spectrum0 3) (J : P.Ellis 3 x) (Z Y : Window.Family)
  (s n t : ℕ),
  s ≤ t →
    ∀ (f g : Vantage → ℝ) (hf : HasCompactSupport f) (hg : HasCompactSupport g),
      (∀ p ∈ P.fineSites t hf,
          ∀ q ∈ P.fineSites t hg, P.transportWidth s n 3 + P.transportWidth s n 3 < P.grid t q 3 - P.grid t p 3) →
        (∀ p ∈ P.fineSites t hf,
            ∀ q ∈ P.fineSites t hg,
              ∀ (j : Axis), P.transportWidth s n j + P.transportWidth s n j < |P.grid t q j - P.grid t p j|) →
          (P.spirits K 3 x) (P.paintPair (Apron.kiss P 3 (P.macroBody Z s n)) (P.macroBody Y s n) t f g) =
            ↑(P.macroTick t ^ 8) *
              ∑ p ∈ P.fineSites t hf,
                ∑ q ∈ P.fineSites t hg,
                  ↑(f (P.grid t p)) * ↑(g (P.grid t q)) * P.rise x s n (P.grid t q - P.grid t p) Z Y
