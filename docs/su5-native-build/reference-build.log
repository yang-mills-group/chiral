                      F;
                  have Sn :=
                    YM.CF.Buffered.Afterglow.Tower.volumeAround Λ l n
                      (YM.CF.Buffered.Afterglow.Tower.reflectedBox j 0
                        (YM.CF.Buffered.Afterglow.Tower.SlabMark.plow (YM.CF.Buffered.Afterglow.Journey.tent Y H) j (↑z)
                          T));
                  have Tn :=
                    YM.CF.Buffered.Afterglow.Tower.volumeAround Λ l n
                      (YM.CF.Buffered.Afterglow.Tower.SlabMark.plow (YM.CF.Buffered.Afterglow.Journey.tent Y H) j (↑z)
                        T);
                  have G :=
                    YM.CF.Buffered.Afterglow.Tower.stream Y H D s n
                      (YM.CF.Buffered.Afterglow.Tower.mirror (YM.CF.Buffered.Afterglow.Journey.tent Y H) j 0 x);
                  have F' := YM.CF.Buffered.Afterglow.Tower.stream Y H D s n x;
                  G ∈ YM.CF.Buffered.Afterglow.Tower.observ (YM.CF.Buffered.Afterglow.Journey.tent Y H) Sn true ∧
                    F' ∈ YM.CF.Buffered.Afterglow.Tower.observ (YM.CF.Buffered.Afterglow.Journey.tent Y H) Tn true ∧
                      YM.CF.Buffered.Afterglow.Tower.stream Y H D s n
                            (afterShift j (YM.CF.Buffered.Afterglow.Journey.tent Y H) (↑z) F F) =
                          G * F' ∧
                        phaseRead Y H V Q Qc j C χ (s + n) (G * F') =
                            phaseRead Y H V Q Qc j C χ s
                              (afterShift j (YM.CF.Buffered.Afterglow.Journey.tent Y H) (↑z) F F) ∧
                          ↑(e ^ 2) < phaseRead Y H V Q Qc j C χ (s + n) (G * F')
