  {χ : Ch} {X : Birthplace Y H V Q Qc j false C χ} {x y : ↥(F₊s)} {f g : Family K} {S T : Finset Cover},
  ↑x = θ ((U(-z)) f) ∧ InTest K false (reflectedBox j 0 (ιM (-z) S)) false ↑x ∧ Neutral K ↑x →
    ↑y = (U(-z - 1)) g ∧ InTest K false (ιM (-z - 1) T) false ↑y ∧ Neutral K ↑y →
      (∀ (w : ℕ), ⟪ς x, (V₀.track (W₀ (1 + w))) (ς y)⟫_ℂ = u₀ (f * (U↑w) g)) →
