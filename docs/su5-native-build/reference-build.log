              ⟪(markedActor Y H V Q Qc j false (C j) F s) x,
                ((Diary.jetTime Y H V Q Qc j false (C j) F).E t) ((markedActor Y H V Q Qc j false (C j) F s) y)⟫_ℂ) →
          (∀ (t : ℕ),
