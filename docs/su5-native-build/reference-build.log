info: Lucent/Chorale.lean:88:0: def YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.Carillon.retention : (P : Spine) →
  {a : ℝ} → 0 < a → (ℕ → ℝ) → (ℕ → ℕ) → P.Spectrum0 3 → ℝ → Prop :=
fun P {a} e β r x ε =>
  have h := basket P e;
  P.HoldRead a r x (Carillon.graph P 2) (Carillon.graph P 4) (dotsB P a 2) (dotsB P a 4) ∧
    Banner.Bought β h x r ∧
      ∀ (k : ℕ),
