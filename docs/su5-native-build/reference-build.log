info: WakeRoad/NextJune.lean:61:0: juneElection : ∀ (D : TintDemand) (m : ℕ),
  ∃ P K E,
    P.PreparedInvestment K E m ∧
      PureForce.CakeL.SignedPoseBudget P ∧
        P.QualifiedWakeReadout K ∧
          P.PhysicalWakeGram ∧
            ∀ (I : ℝ) (p : 0 < I) (f s : ℕ → ℕ),
              StrictMono f →
                StrictMono s →
                  ∀ (J : Type) [Countable J] (Q : J → ℕ → P.Test) (z : J → ℂ),
                    (∀ (i : J), P.WakePoll (Q i) (z i)) →
                      ∃ t c β,
                        StrictMono t ∧
                          StrictMono c ∧
                            Pooling P.run (P.period ∘ P.projection.rows) (P.cutoff ∘ P.projection.columns) (f ∘ c) β ∧
                              ∀ (U : P.Spectrum0 3 → Prop),
                                (∀ᵐ (x : P.Spectrum0 3) ∂P.pillars 3, U x) →
                                  ∃ x,
                                    U x ∧
                                      P.JointTuple K x ∧
                                        P.HoldRead I (s ∘ t) x (corner P.pianist) 0 (testSite P I) 0 ∧
                                          (∀ (k : J) (j : Axis),
                                              Tendsto
                                                (fun r =>
                                                  (P.singleState j (s (t r)) ((P.otherSpectrum 3 j) x)) (Q k (s (t r))))
                                                atTop (𝓝 (z k))) ∧
                                            ∀ᶠ (i : ℕ) in atTop,
                                              have u := (s ∘ t) i;
                                              ∃ F G' δ,
                                                LinkedSpectrum P x (chairCap P I u p β 1) (chairCap P I u p β 0) F G'
                                                    δ ∧
                                                  Morning.covPct P I (Morning.pinM P I p) β x 3 u ≠ 0 ∧
                                                    (∀ (k : Fin 2),
                                                        P.issuing u (chairCap P I u p β k) (eye P I u k) =
                                                          (Morning.pinM P I p).ask β k u) ∧
                                                      Tendsto (fun e => Gingham.Diary.nn P ((f ∘ c) e)) atTop atTop ∧
                                                        ∀ (M : ℝ),
                                                          ∀ᶠ (j : ℕ) in atTop,
                                                            ∃ n W,
                                                              j ≤ n ∧
                                                                MirrorCase P x (chairCap P I u p β 1)
                                                                    (chairCap P I u p β 0) F G' δ M j n W ∧
                                                                  ∀ᶠ (e : ℕ) in atTop,
                                                                    have l := f (c e);
                                                                    Ferry P.run n (Gingham.Diary.irr P l)
                                                                        (Gingham.Diary.uvv P l) ∧
                                                                      ⋯ ∧ ⋯
info: WakeRoad/NextJune.lean:62:0: structure YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.NativeSeam.Hallmark (P : Spine) (x : P.Spectrum0 3)
  (B D : P.Apron) (F U : SampleDose) (δ : ℝ) : Prop
number of parameters: 7
fields:
  YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.NativeSeam.Hallmark.admission : SpanSeam P B D F U
  YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.NativeSeam.Hallmark.all_regions : ∃ A A',
      IsOpen A ∧
        IsOpen A' ∧
          IsCompact (closure A) ∧
            IsCompact (closure A') ∧
              tsupport F.val ⊆ A ∧ tsupport U.val ⊆ A' ∧ ∀ p ∈ closure A, ∀ q ∈ closure A', Cracks P B D p q
  YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.NativeSeam.Hallmark.credit : 0 < δ
  YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.NativeSeam.Hallmark.sunJ : Gingham.Jubilation
      (EuCosts P x B D F U) δ
  YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.NativeSeam.Hallmark.darkJ : Gingham.Jubilation
