          Tendsto (fun t => ⟪P.fineSense x Z s n c f t, P.fineSense x Y s n c g t⟫_ℂ) atTop
            (𝓝
              ⟪(P.enter 3 (P.advocate 3 x 3)) (P.realSense x Z s n c f),
                (P.enter 3 (P.advocate 3 x 3)) (P.realSense x Y s n c g)⟫_ℂ)
