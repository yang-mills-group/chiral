info: YM/SU5/Selected/V.lean:50:0: @Consensus.mk : ∀ {Λ : YM.CF.Py.Rate.LocalLimit.Preparation} {l : ℕ} {Y : Λ.Course (YM.CF.VolumeCape.Dream.Nimbus l)}
  {H : Real.exp 1 ≤ Λ.x} {i k : ℕ → ℕ} {E : ℕ → YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) → ℂ}
  {D :
    ℕ →
      YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) →
        YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H)}
  {a b : ℕ → ℕ} {Q : YM.CF.Buffered.Afterglow.Tower.Coherent Y H D a b} {r : Bool} {x : Sample Y H r},
  (∀ (s : ℕ), x s (legalOne r) = 1) →
    (∀ (s : ℕ) (f g : YM.CF.Buffered.Afterglow.Tower.Vacancy.observable (YM.CF.Buffered.Afterglow.Journey.tent Y H) r),
        x s (combined r f g) = x s f + x s g) →
      (∀ (s : ℕ) (f : YM.CF.Buffered.Afterglow.Tower.Vacancy.observable (YM.CF.Buffered.Afterglow.Journey.tent Y H) r)
          (z : ℂ), x s (weighted r f z) = z * x s f) →
        (∀ (s n : ℕ)
            (f : YM.CF.Buffered.Afterglow.Tower.Vacancy.observable (YM.CF.Buffered.Afterglow.Journey.tent Y H) r),
            x (s + n) (YM.CF.Buffered.Afterglow.Tower.Vacancy.upward Y H Q r f s n) = x s f) →
          (∀ (s : ℕ) (a : YM.Axis) (z : ℤ)
              (f : YM.CF.Buffered.Afterglow.Tower.Vacancy.observable (YM.CF.Buffered.Afterglow.Journey.tent Y H) r),
              x s (stepTest Y H a r z f) = x s f) →
            (∀ (s : ℕ) (a : YM.Axis) (z : ℤ)
                (f : YM.CF.Buffered.Afterglow.Tower.Vacancy.observable (YM.CF.Buffered.Afterglow.Journey.tent Y H) r),
                x s (looking Y H a r (YM.CF.Buffered.Heat.gaugeShift Λ.block z) f) = star (x s f)) →
              (∀ (s : ℕ) (a : YM.Axis) (z : ℤ)
                  (f : YM.CF.Buffered.Afterglow.Tower.Vacancy.observable (YM.CF.Buffered.Afterglow.Journey.tent Y H) r)
                  (p : Finset YM.Lattice.Cover),
                  YM.CF.Buffered.InTest (YM.CF.Buffered.Afterglow.Journey.tent Y H) true p false ↑f →
                    YM.CF.Buffered.Afterglow.Tower.region a (YM.CF.Buffered.Heat.gaugeShift Λ.block z)
                        (YM.CF.Buffered.Afterglow.Journey.tent Y H).ℓ p →
                      0 ≤ x s (glance Y H a r (YM.CF.Buffered.Heat.gaugeShift Λ.block z) f)) →
                Consensus Y H Q r x
info: YM/SU5/Selected/V.lean:51:0: @retinue : ∀ {Λ : YM.CF.Py.Rate.LocalLimit.Preparation} {l : ℕ} (Y : Λ.Course (YM.CF.VolumeCape.Dream.Nimbus l))
  (H : Real.exp 1 ≤ Λ.x) {i k : ℕ → ℕ}
  {I : ℕ → YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) → ℕ → ℂ}
  {E : ℕ → YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) → ℂ}
  (V : YM.CF.Buffered.Afterglow.Journey.Universal Y H i k I E)
  {D :
    ℕ →
      YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) →
        YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H)}
  {a b : ℕ → ℕ} (Q : YM.CF.Buffered.Afterglow.Tower.Coherent Y H D a b) (Qc : Clipped Y H (i ∘ a) (k ∘ b)) (j : YM.Axis)
  (C : YM.CF.Buffered.Afterglow.Tower.Arena Y H Q.circuit j 0 false) (z : ℤ) (s : ℕ)
  {f g : YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H)} {S T : Finset YM.Lattice.Cover} {a0 k0 : ℝ},
  (∀ x ∈ S,
      x j + ↑(YM.CF.Buffered.Afterglow.Journey.tent Y H).ℓ ≤ ruler (YM.CF.Buffered.Afterglow.Journey.tent Y H).B * z) →
    (∀ x ∈ T,
        ruler (YM.CF.Buffered.Afterglow.Journey.tent Y H).B * z + ruler (YM.CF.Buffered.Afterglow.Journey.tent Y H).B +
            ↑(YM.CF.Buffered.Afterglow.Journey.tent Y H).ℓ ≤
          x j) →
      Alight Y H V Q Qc j C s a0 k0 f g S T →
        ∀ {χ : CapCharacter Y H V Q Qc j false C} (X : Birthplace Y H V Q Qc j false C χ),
          ∃ x y,
            ↑x =
                YM.CF.Buffered.Afterglow.Tower.mirror (YM.CF.Buffered.Afterglow.Journey.tent Y H) j 0
                  (relocate (YM.CF.Buffered.Afterglow.Journey.tent Y H) j (-z) f) ∧
              ↑y = relocate (YM.CF.Buffered.Afterglow.Journey.tent Y H) j (-z - 1) g ∧
                YM.CF.Buffered.InTest (YM.CF.Buffered.Afterglow.Journey.tent Y H) false
                    (YM.CF.Buffered.Afterglow.Tower.reflectedBox j 0
                      (plow (YM.CF.Buffered.Afterglow.Journey.tent Y H) j (-z) S))
                    false ↑x ∧
                  YM.CF.Buffered.InTest (YM.CF.Buffered.Afterglow.Journey.tent Y H) false
                      (plow (YM.CF.Buffered.Afterglow.Journey.tent Y H) j (-z - 1) T) false ↑y ∧
                    YM.CF.Buffered.Afterglow.Tapestry.Neutral (YM.CF.Buffered.Afterglow.Journey.tent Y H) ↑x ∧
                      YM.CF.Buffered.Afterglow.Tapestry.Neutral (YM.CF.Buffered.Afterglow.Journey.tent Y H) ↑y ∧
                        inner ℂ (vacuum Y H V Q Qc j false C X) ((markedActor Y H V Q Qc j false C X s) x) = 0 ∧
                          inner ℂ (vacuum Y H V Q Qc j false C X) ((markedActor Y H V Q Qc j false C X s) y) = 0 ∧
                            inner ℂ ((markedActor Y H V Q Qc j false C X s) x)
                                (((journey Y H V Q Qc j false C X).track
                                    (YM.CF.Buffered.Afterglow.Tower.MeshClock.whenly
                                      (YM.CF.Buffered.Afterglow.Tower.timeMesh Λ) s 1))
                                  ((markedActor Y H V Q Qc j false C X s) y)) =
                              phaseRead Y H V Q Qc j C χ s (f * g)
