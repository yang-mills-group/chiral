info: SatinThinSpring.lean:75:0: YM.CF.Buffered.Afterglow.Tower.VacuumSelection.partridge (X : TintDemand) (Y : Supplier) (L M : ℝ) (p : 0 < M)
  (z : ℕ → ℕ) :
  ∃ n_,
    2 * Ione.strive_E 6 ≤ ↑n_ ∧
      ∃ P K,
        uniform P K Y L M ∧
          P.Roster ∧
            P.NightCop ∧
              TintCommercial n_ (crayon X) P.par ∧
                Meritorious P.par ∧
                  15 ∣ ↑P.par.R.L ∧
                    ↑P.par.R.L % 16 = 1 ∧
                      (∀ᶠ (s : ℕ) in atTop,
                          ∀ (i k : ℕ),
                            (P.run.voyage i).kick ≤ k →
                              s ≤ P.run.uv k →
                                VLine P.run s i k
                                  (SectorNext.Remainder.Scales.merit P.par.R.L (hat P.par.R.L P.par.x s))) ∧
                        Yoke.Dispatchers P.par ∧
                          (∃ C ≥ 1,
                              Yoke.Drawbill P.par C ∧
                                ∀ᶠ (s : ℕ) (i : ℕ) in atTop,
                                  ∀ (k : ℕ),
                                    (P.run.voyage i).kick ≤ k → s ≤ P.run.uv k → Yoke.ShelterCost C P.run s i k) ∧
                            (∃ A,
                                Chronicle P.run A ∧
                                  ∀ᶠ (f : ℕ) in atTop,
                                    ∀ (r : ℕ),
                                      f < r →
                                        ∀ (v : ℕ),
                                          r ≤ v →
                                            ∀ᶠ (i : ℕ) in atTop,
                                              ∀ (k : ℕ),
                                                (P.run.voyage i).kick ≤ k →
                                                  v ≤ P.run.uv k → Yoke.PaysTilt P.run i k f r v A) ∧
                              ∃ c r x,
                                z ≤ r ∧
                                  ∃ J,
                                    P.Experiment K c r x J ∧
                                      P.Transmission x c r ∧
                                        ∀ (U V : Doorway) (order : Orders),
                                          U.Later V order 0 →
                                            ∀ᶠ (i : ℕ) in atTop,
                                              ∃ a F G,
                                                Dose.Normalized F ∧
                                                  Dose.Normalized G ∧
                                                    tsupport F.val ⊆ U.invites ∧
                                                      tsupport G.val ⊆ V.invites ∧
                                                        P.ReturnsSix x (c i) (r i) a F G ∧
                                                          P.FixedSatinReadings K x (c i) (r i) a F G
