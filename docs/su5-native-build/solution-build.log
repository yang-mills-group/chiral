                  (T : YM.Pressure.Tube G S) (H H' : YM.Precision.Bed) (P : YM.Precision.Towers S.patch.L)
                  (q : S.Choices),
                  T.high.direct = μ →
                    S.kernel = Q →
                      ∀ (X u a D d : ℝ),
                        0 < X →
                          0 < d →
                            YM.Precision.Towers.Diagonal S H H' P →
                              YM.FreeResolvent.Gap (H'.metric.acts c) d →
                                (H'.metric.acts c).transpose = H'.metric.acts c →
                                  T.up.Bounds T.high σ C u →
                                    YM.Precision.Attached H T.up →
                                      YM.Precision.Floor H T.high f X a →
                                        YM.Bid.Larger S →
                                          YM.Bid.Sworn H f G →
                                            ∀ (x b b' j : ℝ),
                                              B ≤ x →
                                                B ≤ b →
                                                  0 < b' →
                                                    B ≤ j →
                                                      |Real.log b' - Real.log b| ≤ cup G ρ →
                                                        0 <
                                                            Matrix.det
                                                              (YM.CF.Neige.baseX T x
                                                                (YM.AnalyticBridge.LocalGaussianLaws.bareStores S) F q
                                                                1) ∧
                                                          |tariff L T F q b x j -
                                                                (schedule L f H b - schedule L c H' b')| ≤
                                                            ρ * bulk f
