info: YM/SU5/Selected/VIIA.lean:25:0: @plateau : ∀ {I : Type u_1} {J : Type u_2} {K : Type u_3} {R : Type u_4} [inst : Fintype I] [inst_1 : DecidableEq I]
  [inst_2 : Fintype J] [inst_3 : DecidableEq J] [inst_4 : Fintype K] [DecidableEq K] [inst_6 : Fintype R]
  [inst_7 : DecidableEq R] (P : Matrix J I ℝ) (p : ℝ) (A : Matrix I I ℝ) (B : Matrix J J ℝ) (L : Matrix R I ℝ)
  (R' : Matrix R J ℝ) (X : Matrix (I ⊕ J) K ℤ) (S F : Finset I) (T : Finset J),
  Arbor X (S.disjSum ∅) →
    Arbor X (F.disjSum T) →
      A.transpose = A →
        p ≠ 0 →
          bolt A P p * realM X = 0 →
            seat L 0 * realM X = 0 →
              seat 0 R' * realM X = 0 →
                ∀ (W : Matrix I R ℝ),
                  A * W = 0 →
                    L * W = 1 →
                      R' * (P * W) = 1 →
                        IsUnit (principal (rose p A P) F).det →
                          p • 1 -
                                -p • P * (wrote F).transpose * (principal (rose p A P) F)⁻¹ *
                                  (wrote F * -p • P.transpose) =
                              B →
                            p ^ Fintype.card J * (principal (A + L.transpose * L) S).det =
                              (principal (rose p A P) F).det * (principal (B + R'.transpose * R') T).det
info: YM/SU5/Selected/VIIA.lean:26:0: @quantization : ∀ {c f : YM.Lattice.Side} (S : YM.RG.StepData c f) (F : YM.Tree.Forest S.ratio) (T L : YM.Precision.Bed)
  (Q : YM.Precision.Towers S.patch.L) (G : YM.Gauge) [Nonempty G.ColorIndex],
  YM.Precision.Towers.Diagonal S T L Q →
    ∀ (a : ℝ),
      0 < a →
        YM.Bid.Larger S →
          YM.FreeResolvent.Gap (T.metric.acts f) a →
            (T.metric.acts f).transpose = T.metric.acts f →
              ∀ (R : Finset (Reed f)) (A : Finset (Reed c)),
                Arbor (sky f) R →
                  Arbor (sky c) A →
                    S.kernel.penalty ^ Fintype.card (Reed c) * Chene f T R =
                      (YM.Further.CurvedGaussianJets.Flat.history S F T).det * Chene c L A
