info: YM/SU5/Selected/Time/Paris.lean:73:0: constructor YM.CF.Buffered.Afterglow.Tower.Selection.Fern.TimeTwist.Luminary.mk : ∀ {Λ : Preparation} {l : ℕ}
  {Y : Λ.Course (VolumeCape.Dream.Nimbus l)} {H : Real.exp 1 ≤ Λ.x} {i k : ℕ → ℕ} {I : ℕ → Family K → ℕ → ℂ}
  {E : ℕ → Family K → ℂ} {V : Universal Y H i k I E} {D : ℕ → Family K → Family K} {a b : ℕ → ℕ}
  {Q : Coherent Y H D a b} {Qc : Clipped Y H (i ∘ a) (k ∘ b)} {C : (j : Axis) → Arena Y H ⋯ j 0 false} {s : ℕ}
  {A : Mezz} {W : Window.Family} {e : A.Legate} {F F' : A.Sermon K W} {χ : CapCharacter Y H V Q Qc 3 false (C 3)}
  {r : ℕ} {X : Finset A.Lot} {d : A.BlockDay} {v : Bool} {x y : ℂ} {ξ : ℝ},
  (∀ (j : Axis),
      Divert A K F F' e X d v r (Tender.stint Λ.block A.marks)
        (phaseRead Y H V Q Qc j (C j) (escort Y H V Q Qc 3 false (C 3) j (C j) χ) s) x y) →
    ↑g₀ ∈ Rubric.Marble K W A.Zumba (A.coast_b true) (A.coast_b false) A.Broad (10 * #X) (10 * #X) #X →
      (↑g₀ = ↑(coast_fadeY A K F F' e X d x y) * ↑(coast_fadeZ A K F e X) ∧
          ∀ (j : Axis),
            Alight Y H V Q Qc j (C j) s ξ (grate Λ l s) (↑(coast_fadeY A K F F' e X d x y)) (↑(coast_fadeZ A K F e X))
              (A.coast_b true) (A.coast_b false)) →
        (∃ i_1,
            Odd (regCard A X i_1) ∧
              ↑g₀ = ↑(melt0 A K F F' e X d false x y i_1) * ↑(melt1 A K F F' e X d false x y i_1) ∧
                ∀ (j : Axis),
                  Alight Y H V Q Qc j (C j) s ξ (grate Λ l s) (↑(melt0 A K F F' e X d false x y i_1))
                    (↑(melt1 A K F F' e X d false x y i_1)) (V₀ i_1 false) (V₁ i_1 false)) →
          (∀ (i : A.BlockDay) (b : Bool),
              (∀ u ∈ V₀ i b, u 3 + ↑K.ℓ ≤ ruler K.B * boundaryT A K i b) ∧
                ∀ u ∈ V₁ i b, ruler K.B * boundaryT A K i b + ruler K.B + ↑K.ℓ ≤ u 3) →
            (∀ (i_1 : A.BlockDay) (b_1 : Bool),
                ↑g₀ = ↑(melt0 A K F F' e X d b_1 x y i_1) * ↑(melt1 A K F F' e X d b_1 x y i_1) ∧
                  ∀ (j : Axis),
                    Gala Y H V Q Qc j (C j) s (V₀ i_1 b_1) (V₁ i_1 b_1) (↑(melt0 A K F F' e X d b_1 x y i_1))
                      (↑(melt1 A K F F' e X d b_1 x y i_1)) ξ) →
              (∀ (i_1 : A.BlockDay) (b_1 : Bool) (n : ℕ),
                  let F₁ := relocate K 3 ↑n ↑(melt1 A K F F' e X d b_1 x y i_1);
                  let F₀ := ↑(melt0 A K F F' e X d b_1 x y i_1);
                  icing A K F F' e X d b_1 x y n i_1 = F₀ * F₁ ∧
                    ∃ c, ∀ (j : Axis), Gala Y H V Q Qc j (C j) s (V₀ i_1 b_1) ((P↑n) (V₁ i_1 b_1)) F₀ F₁ ↑c) →
                Luminary Y H V Q Qc C s e F F' χ r X d v x y ξ
