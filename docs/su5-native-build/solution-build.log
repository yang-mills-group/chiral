  0 < t →
    t ≤ 1 →
      Λ.d ≤ YM.CF.Py.Rate.LocalLimit.Papal.Mileage.austere →
        ∀ (ε : ℝ),
          0 < ε →
            ∀ (v : ℝ),
              ∀ᶠ (s : ℕ) in Filter.atTop,
                ∀ (i k : ℕ),
                  s ≤ Y.uv k →
                    (Y.voyage i).kick ≤ k →
                      ∀ (T : ℝ) (F : YM.CF.Buffered.Mark (YM.CF.Py.Rate.LocalLimit.age Y i s)),
                        YM.RG.Envelope F →
                          YM.CF.Py.Rate.LocalLimit.Rundle.IcyBudget Y t T s i k v F →
                            have V := YM.CF.Py.Rate.LocalLimit.Preparation.RootBook Y i k s;
                            have f := YM.CF.Py.Rate.LocalLimit.Rundle.dawnM Y s i;
                            let N := YM.CF.Py.Rate.LocalLimit.age Y i s;
                            ∫ (x : YM.CF.Skye.Orbit N),
                                ‖(YM.CF.Buffered.letterRead (F (x.1, f x)))
                                    (YM.CF.Graph.recX Λ.U V f x)‖ ∂YM.CF.Scree.city N ≤
                              Real.exp
                                (YM.CF.Py.Rate.LocalLimit.marks Y i k s +
                                    (YM.CF.Py.Rate.LocalLimit.Rundle.season_tip * t ^ 2 + ε) * YM.CF.Py.Rate.sites N +
                                  T)
