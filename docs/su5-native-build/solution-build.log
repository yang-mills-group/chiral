  YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.Purchase.BasePrice.mk {y : Purchase}
    (stamps :
      ∀ᶠ (i : ℕ) in atTop,
        ∀ (t : ℕ),
          y.budget i ≤ t →
            ∀ (j : Axis) (a : Lead.Clan),
              y.spine.MayChord y.point j t y.early (y.earliest a i t) (Purchase.euHead j y a i t) ∧
                y.spine.MayChord y.point j t y.late (y.latest a i t) (Purchase.euToe j y a i t))
    (pens : ∀ (j : Axis), Selected.Victory y.spine.run ⋯ ⋯ ⋯ ⋯ false j (y.spine.room j) (y.spine.mayChar y.point j))
    (buys :
      ∀ (j : Axis) (v : (y.spine.ManyF j (y.spine.advocate 3 y.point j)).space) (d : E4),
        let f := y.spine.mayIntertwineS y.point j;
        let T := peninsula y.spine.run ⋯ ⋯ ⋯ ⋯ j false (y.spine.room j) (y.spine.mayChar y.point j);
        let S := y.spine.seasons j (y.spine.advocate 3 y.point j);
        (T.unit.translation d) (f v) = f ((S.unit.translation d) v) ∧ T.ℚmeasure.diagonal (f v) = S.ℚmeasure.diagonal v)
    (reading :
      ∀ᶠ (i : ℕ) in atTop,
        ∀ (t : ℕ),
          y.budget i ≤ t →
            (∀ (a : Lead.Clan), (y.read t) (y.earliest a i t) = 0 ∧ (y.read t) (y.latest a i t) = 0) ∧
              y.actualPrism i t (y.compareSplit t) = 0 ∧
                ∀ (j : Axis),
                  Purchase.angularPrism j y i t = y.spine.glasshousePrism y.point y.A y.c y.r y.n y.w y.F y.U i t ∧
                    Purchase.angularPrism j y i t = y.actualPrism i t (y.read t) - y.actualPrism i t (y.compareSplit t))
    (margin :
      ∃ d > 0,
        LoudMargin y.finalPage d ∧
          ∀ᶠ (i : ℕ) in atTop, ∀ (t : ℕ), y.budget i ≤ t → ∀ (j : Axis), LoudMargin (Purchase.angularPrism j y i t) d)
    (matrix_limits :
      (∀ᶠ (i : ℕ) in atTop, ∀ (j : Axis), Tendsto (fun t => Purchase.angularPrism j y i t) atTop (𝓝 (y.page i))) ∧
        Tendsto y.page atTop (𝓝 y.finalPage))
    (kets :
      (∀ᶠ (i : ℕ) in atTop,
          ∀ (a : Lead.Clan),
            let T := ⋯;
            let Z' := y.spine.mayIntertwineS y.point 3;
            Tendsto (y.headKet a i) atTop (𝓝 ↑(Z' (y.spine.thinKet y.point (y.body a i) T (flipDose y.F 3)))) ∧
              Tendsto (y.toeKet a i) atTop (𝓝 ↑(Z' (y.spine.thinKet y.point (y.body a i) T y.U)))) ∧
        (∀ (a : Lead.Clan),
            let Z' := y.spine.mayIntertwineS y.point 3;
            Tendsto (fun i => Z' (y.spine.thinKet y.point (y.body a i) ⋯ (flipDose y.F 3))) atTop (𝓝 (y.headThin a)) ∧
              Tendsto (fun i => Z' (y.spine.thinKet y.point (y.body a i) ⋯ y.U)) atTop (𝓝 (y.toeThin a))) ∧
          ∀ (a b : Lead.Clan), y.finalPage a b = ⟪y.headThin a, y.toeThin b⟫_ℂ) :
    y.BasePrice
