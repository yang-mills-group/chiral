  {D :
    ℕ →
      YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) →
        YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H)}
  {a b : ℕ → ℕ} (Q : YM.CF.Buffered.Afterglow.Tower.Coherent Y H D a b) (Qc : Clipped Y H (i ∘ a) (k ∘ b))
  (C : (j : YM.Axis) → YM.CF.Buffered.Afterglow.Tower.Arena Y H Q.circuit j 0 false) {ξ : ℝ} (s : ℕ) {X₀ : Mezz}
  (χ : CapCharacter Y H V Q Qc 3 false (C 3)) (e : X₀.Legate) {F : YM.CF.Window.Family}
  (Z : X₀.Sermon (YM.CF.Buffered.Afterglow.Journey.tent Y H) F)
  {X : Birthplace Y H V Q Qc 3 false (C 3) (escort Y H V Q Qc 3 false (C 3) 3 (C 3) χ)},
  LoneVac Y H V Q Qc 3 false (C 3) X →
    ∀ (s' : Finset X₀.Lot),
      Guild.Radiant Y H V Q Qc C s χ e Z s' ξ →
        ∀ (x y : ↥(YM.CF.Buffered.Afterglow.Tower.Field Y H s 3 0 false)),
          inner ℂ (vacuum Y H V Q Qc 3 false (C 3) X) ((markedActor Y H V Q Qc 3 false (C 3) X s) x) = 0 →
            inner ℂ (vacuum Y H V Q Qc 3 false (C 3) X) ((markedActor Y H V Q Qc 3 false (C 3) X s) y) = 0 →
              inner ℂ ((markedActor Y H V Q Qc 3 false (C 3) X s) x)
                    (((journey Y H V Q Qc 3 false (C 3) X).track
                        (YM.CF.Buffered.Afterglow.Tower.MeshClock.whenly (YM.CF.Buffered.Afterglow.Tower.timeMesh Λ) s
                          1))
                      ((markedActor Y H V Q Qc 3 false (C 3) X s) y)) =
                  phaseRead Y H V Q Qc 3 (C 3) (escort Y H V Q Qc 3 false (C 3) 3 (C 3) χ) s
                    ↑(Sermon.embrace X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) e Z s') →
                Sermon.honey X₀ <
                    ‖inner ℂ ((markedActor Y H V Q Qc 3 false (C 3) X s) x)
                        (((journey Y H V Q Qc 3 false (C 3) X).track
                            (YM.CF.Buffered.Afterglow.Tower.MeshClock.whenly (YM.CF.Buffered.Afterglow.Tower.timeMesh Λ)
                              s 1))
                          ((markedActor Y H V Q Qc 3 false (C 3) X s) y))‖ ∧
                  (markedActor Y H V Q Qc 3 false (C 3) X s) x ∉ bottom Y H V Q Qc 3 false (C 3) X ∧
                    (markedActor Y H V Q Qc 3 false (C 3) X s) y ∉ bottom Y H V Q Qc 3 false (C 3) X ∧
                      ((journey Y H V Q Qc 3 false (C 3) X).track
                              (YM.CF.Buffered.Afterglow.Tower.MeshClock.whenly
                                (YM.CF.Buffered.Afterglow.Tower.timeMesh Λ) s 1))
                            ((markedActor Y H V Q Qc 3 false (C 3) X s) x) ∉
                          bottom Y H V Q Qc 3 false (C 3) X ∧
                        ((journey Y H V Q Qc 3 false (C 3) X).track
                              (YM.CF.Buffered.Afterglow.Tower.MeshClock.whenly
                                (YM.CF.Buffered.Afterglow.Tower.timeMesh Λ) s 1))
                            ((markedActor Y H V Q Qc 3 false (C 3) X s) y) ∉
                          bottom Y H V Q Qc 3 false (C 3) X
