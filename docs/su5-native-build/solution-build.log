  (Y : Λ.Course (YM.CF.VolumeCape.Dream.Nimbus l)) (H : Real.exp 1 ≤ Λ.x) {i k : ℕ → ℕ}
  {I : ℕ → YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) → ℕ → ℂ}
  {E : ℕ → YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) → ℂ}
  (V : YM.CF.Buffered.Afterglow.Journey.Universal Y H i k I E)
  {D :
    ℕ →
      YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) →
        YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H)}
  {a b : ℕ → ℕ} (Q : YM.CF.Buffered.Afterglow.Tower.Coherent Y H D a b) (Qc : Clipped Y H (i ∘ a) (k ∘ b))
  (C : (j : YM.Axis) → YM.CF.Buffered.Afterglow.Tower.Arena Y H Q.circuit j 0 false) {ξ : ℝ} (s : ℕ) {X₀ : Mezz}
  (χ : CapCharacter Y H V Q Qc 3 false (C 3)) (e : X₀.Legate) {F : YM.CF.Window.Family}
  (Z : X₀.Sermon (YM.CF.Buffered.Afterglow.Journey.tent Y H) F) (s' : Finset X₀.Lot),
  Guild.Radiant Y H V Q Qc C s χ e Z s' ξ →
    ∀ (v : YM.Axis) (n : ℕ),
      ∃ u w,
        ↑u = ↑(Sermon.Liturgy X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) e Z s' true) ∧
          ↑w = ↑(Sermon.Liturgy X₀ (YM.CF.Buffered.Afterglow.Journey.tent Y H) e Z s' false) ∧
            have x := YM.CF.Buffered.Afterglow.Tower.Vacancy.upward Y H Q false u s n;
            have y := YM.CF.Buffered.Afterglow.Tower.Vacancy.upward Y H Q false w s n;
            YM.CF.Buffered.Afterglow.Tower.Vacancy.cap Y H V (s + n) Q Qc v false (C v) (composed false x y) ≠
              YM.CF.Buffered.Afterglow.Tower.Vacancy.cap Y H V (s + n) Q Qc v false (C v) x *
                YM.CF.Buffered.Afterglow.Tower.Vacancy.cap Y H V (s + n) Q Qc v false (C v) y
