                  let u := YM.CF.Buffered.Afterglow.Tower.Vacancy.upward Y H Q false z s n;
                  let v := YM.CF.Buffered.Afterglow.Tower.Vacancy.upward Y H Q false z' s n;
                  ↑u ∈
