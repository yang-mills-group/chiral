info: YM/SU5/May/LunarCheckpoint.lean:70:0: def YM.CF.Buffered.Afterglow.Tower.FirstWindows.Screened.Torque.YieldPlate : {Λ : Preparation} →
  {l : ℕ} → Λ.Course (VolumeCape.Dream.Nimbus l) → Tilted.Ramp → ℝ≥0 → Prop :=
fun {Λ} {l} «Y» P r =>
  ∀ (s : ℕ) (W : Finset Cover), PhaseChoice.SupportedPhysically Λ l s W (Ωₙ P r) → ∃ v, 0 < v ∧ able «Y» s P v W
info: YM/SU5/May/LunarCheckpoint.lean:71:0: def YM.CF.Buffered.Afterglow.Tower.FirstWindows.Screened.Torque.Sail : {Λ : Preparation} →
  {l : ℕ} →
    («Y» : Λ.Course (VolumeCape.Dream.Nimbus l)) →
      («H» : Real.exp 1 ≤ Λ.x) →
        {i k : ℕ → ℕ} → {E : ℕ → Family (tent «Y» «H») → ℂ} → GroundExtension «Y» «H» → Tilted.Ramp → ℝ≥0 → Prop :=
fun {Λ} {l} «Y» «H» {i k} {E} «G» P r =>
  ∀ (s : ℕ),
    ∀ f ∈ insideAt Λ l (tent «Y» «H») true (Ωₙ P r) s,
      ∀ (ε : ℝ),
        0 < ε →
          ∃ᶠ (n : ℕ) (d : ℕ) in atTop,
            ∃ a z U,
              Cred «Y» (i («G».rows n)) (k d) (s + a) z ∧
                Paid «Y» «H» «G» s P f n (k d) a z ε U ∧ -ε ≤ (overcast «Y» «H» «G» s P f n (k d) a z U).re
