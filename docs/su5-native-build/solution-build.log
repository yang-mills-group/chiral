info: GaugeFieldConstruction/StencilCelebrity.lean:125:0: @starsBothHead_st : ∀ {nLeaf : ℕ} {process : Spine} {production : process.YardμN CostUpVU PolRun PriceArtVU nLeaf}
  {growth : InterR} {roles : ConsoleθN production ΓmotVU 0 growth ΓstageVU} {axes : Axis → Empire.Across}
  {comparison : Sheds roles.Crew_N axes} {approvals : Supplies comparison} {stress : Ticket roles.Gamma_N approvals}
  {vacuum : process.Spectrum0 3} {layers : NSF.Boundary.Waves (roles.RadianceVU stress)}
  {response : NSF.Boundary.Surface (roles.RadianceVU stress)} {model : roles.GlowVU stress vacuum ⋯ layers response}
  (u : WordSeatSt model) {V : Type u_2} [inst : AddCommGroup V] [inst_1 : Module ℂ V]
  (G : Carton (process.seasons 3 (process.advocate 3 vacuum 3)) V) (X Y : Module.End ℂ ↥model.system.operators.domain)
  (s t : V) (f g : Test4) {F : InkWaves V} {Z : WView V},
  InkPort G F Z →
    G.omega = process.heaven 3 (process.advocate 3 vacuum 3) →
      WordLiftSt.sends u X ((G.operator s) f) →
        WordLiftSt.sends u Y ((G.operator t) g) →
