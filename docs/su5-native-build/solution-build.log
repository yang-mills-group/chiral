                                        (𝓝 (P.thinJournal x A c r n w X F U i))) ∧
                                    Tendsto (P.thinJournal x A c r n w X F U) atTop (𝓝 (P.readPrism x V w 1 F U))) ∧
                                  ∀ᶠ (i : ℕ) in atTop,
                                    ∀ (t : ℕ),
                                      c (n i) ≤ t →
                                        ∀ (a : Lead.Clan) (u : Hierarchy.Charm.W P.calibration),
                                          Hierarchy.LyraBill.Chiffon.Sesame.FlakeNight.Verne.GNative P.calibration u →
                                            ↑(P.prepared t (Apron.kiss P 3 (P.soldTrumpet A c r n w a i)) F) ≠ ↑u ∧
                                              ↑(P.prepared t (P.soldTrumpet A c r n w a i) U) ≠ ↑u
