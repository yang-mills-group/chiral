info: YM/SU5/May/BaseCheckpoint.lean:213:0: YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.existsPurchase : Nonempty Purchase
info: YM/SU5/May/BaseCheckpoint.lean:214:0: structure YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.Purchase.BasePrice (y : Purchase) : Prop
number of parameters: 1
fields:
  YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.Purchase.BasePrice.stamps : ∀ᶠ (i : ℕ) in atTop,
      ∀ (t : ℕ),
        y.budget i ≤ t →
          ∀ (j : Axis) (a : Lead.Clan),
            y.spine.MayChord y.point j t y.early (y.earliest a i t) (Purchase.euHead j y a i t) ∧
              y.spine.MayChord y.point j t y.late (y.latest a i t) (Purchase.euToe j y a i t)
  YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.Purchase.BasePrice.pens : ∀ (j : Axis),
      Selected.Victory y.spine.run ⋯ ⋯ ⋯ ⋯ false j (y.spine.room j) (y.spine.mayChar y.point j)
  YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.Purchase.BasePrice.buys : ∀ (j : Axis)
      (v : (y.spine.ManyF j (y.spine.advocate 3 y.point j)).space) (d : E4),
      let f := y.spine.mayIntertwineS y.point j;
      let T := peninsula y.spine.run ⋯ ⋯ ⋯ ⋯ j false (y.spine.room j) (y.spine.mayChar y.point j);
      let S := y.spine.seasons j (y.spine.advocate 3 y.point j);
      (T.unit.translation d) (f v) = f ((S.unit.translation d) v) ∧ T.ℚmeasure.diagonal (f v) = S.ℚmeasure.diagonal v
