info: YM/SU5/Selected/Cor/Guild.lean:81:0: constructor YM.CF.Buffered.Afterglow.Tower.Selection.Fern.Alight.mk : ∀ {Λ : Preparation} {l : ℕ}
  {Y : Λ.Course (VolumeCape.Dream.Nimbus l)} {H : Real.exp 1 ≤ Λ.x} {i k : ℕ → ℕ} {I : ℕ → Family K → ℕ → ℂ}
  {E : ℕ → Family K → ℂ} {V : Universal Y H i k I E} {D : ℕ → Family K → Family K} {a b : ℕ → ℕ}
  {Q : Coherent Y H D a b} {Qc : Clipped Y H (i ∘ a) (k ∘ b)} {j : Axis} {C : Arena Y H ⋯ j 0 false} {s : ℕ} {c k₁ : ℝ}
  {X X' : Family K} {S T : Finset Cover},
  GalleryG Λ l s c k₁ S T →
    Sermon.luxury K X S →
      Sermon.luxury K X' T →
        (∀ (z z' : observable K false),
            ↑z = X →
              ↑z' = X' →
                ∀ (χ : Ch) (n : ℕ),
                  let u := Vacancy.upward Y H Q false z s n;
                  let v := Vacancy.upward Y H Q false z' s n;
                  ↑u ∈ observ K (MS S) true ∧
                    ↑v ∈ observ K (MS T) true ∧
                      Vacancy.upward Y H Q false (composed false z z') s n = composed false u v ∧
                        (N s) (composed false z z') = (N(s + n)) (composed false u v) ∧
                          (N(s + n)) u = 0 ∧
                            (N(s + n)) v = 0 ∧
                              E (s + n) ↑u = 0 ∧
                                E (s + n) ↑v = 0 ∧
                                  readχ χ (s + n) ↑u = 0 ∧
                                    readχ χ (s + n) ↑v = 0 ∧
                                      readχ χ (s + n) (↑u * ↑v) = readχ χ s (X * X') ∧
                                        E (s + n) (↑u * ↑v) = E s (X * X')) →
          Alight Y H V Q Qc j C s c k₁ X X' S T
