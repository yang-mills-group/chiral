  (∀ (n : ℕ), 0 < b n) →
    ∀ (e v D : ℝ) (X : Supplier),
      0 < v →
        0 < D →
          ∀ (z : ℕ → ℕ),
            ∃ P K,
              uniform P K X e v ∧
                ∃ r,
                  z ≤ r ∧
                    ∃ c,
                      Launch P c r ∧
                        Spine.aura0 A b P c ∧
                          roughUV P c r keyV ∧
                            ∃ α t,
                              0 < α ∧
                                0 < t ∧
                                  t < D ∧
                                    ∃ Y,
                                      ∀ᶠ (i : ℕ) in atTop,
                                        ∃ x,
                                          P.party 3 K x ∧
                                            Spine.aura' A b P c x ∧
                                              readyUV P c r x keyV ∧
                                                P.funds i ((P.otherSpectrum 3 3) x) Y t ∧
                                                  ∀ (z : SU.Slot),
                                                    P.Intact K i Y.toGaze x z t ∧
                                                      P.Royal i ((P.otherSpectrum 3 3) x) Y (family z) t ∧
                                                        P.Passage x c r K z ∧ P.Bands x (family z) c r
