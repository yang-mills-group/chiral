      ∀ (s : ℕ) (f : Dome (tent P.run ⋯)) (A : Tilted.Ramp) (r : ℝ≥0) {T : Finset Cover},
        InTest (tent P.run ⋯) true T false ↑f →
          f ∈ insideAt P.par P.width (tent P.run ⋯) true (Ωₙ A r) s →
            ∃ κ Q,
              0 ≤ Q ∧
                ∀ (n t a : ℕ) (z : Intermediate.Room (s + a)),
                  Cred P.run (P.period (P.projection.rows n)) t (s + a) z →
                    Maintain (side P.run (P.period (P.projection.rows n)) (s + a)) false κ (price_leg P.par s a) Q
                      (Satin.region (volumeAround P.par P.width a T)
                        (side P.run (P.period (P.projection.rows n)) (s + a)))
                      (tractor P.run ⋯ P.projection s t n a z f))
    (caps :
      ∀ (u : ℝ),
        0 < u →
          ∃ A ≥ 0,
            ∀ (n s a : ℕ),
              s + a ≤ turnUp P.run n → price_leg P.par s a ≤ (√↑↑P.par.R.L)⁻¹ ^ a * Real.exp (A * ↑↑(P.run.ir n) ^ u))
    (needs :
      (∀ (A : Tilted.Ramp), ∃ r, YieldPlate P.run A r ∧ Sail P.run ⋯ P.projection A r) →
        ∀ (e r : ℝ), 0 < e → 0 ≤ r → StageT P.run ⋯ ⋯ P.projection P.room 3 (P.glasshouseCharacter 3 x) e r) :
    P.AngleWages x
info: YM/SU5/May/TorqueCP.lean:74:0: def YM.CF.Buffered.Afterglow.Tower.FirstWindows.Screened.Torque.YieldPlate : {Λ : Preparation} →
  {l : ℕ} → Λ.Course (VolumeCape.Dream.Nimbus l) → Tilted.Ramp → ℝ≥0 → Prop :=
fun {Λ} {l} «Y» P r =>
  ∀ (s : ℕ) (W : Finset Cover), PhaseChoice.SupportedPhysically Λ l s W (Ωₙ P r) → ∃ v, 0 < v ∧ able «Y» s P v W
info: YM/SU5/May/TorqueCP.lean:75:0: def YM.CF.Buffered.Afterglow.Tower.FirstWindows.Screened.Torque.SalaryHere : {Λ : Preparation} →
  {l : ℕ} → Λ.Course (VolumeCape.Dream.Nimbus l) → ℕ → ℕ → ℕ → Tilted.Ramp → ℝ → Finset Cover → Prop :=
fun {Λ} {l} «Y» m t s P v F =>
  ∀ (b : Bool) (x : Ket (Single (side «Y» m s))),
    withinM (if b = true then (Tset (side «Y» m s))ᶜ else Tset (side «Y» m s)) x →
      withinM (modesIn (side «Y» m s) (Satin.region F (side «Y» m s))) x →
        -(Torque.gentle «Y» v m s * ‖x‖ ^ 2) ≤
          (May.TorqueBeam.promoted (P.vehicle (side «Y» m s))
              (Hygrometry.ledger (side «Y» m s) Λ.K.j (freshBook «Y» m t s).M) 0 (b, x) (b, x)).re
info: YM/SU5/May/TorqueCP.lean:76:0: def YM.CF.Buffered.Afterglow.Tower.FirstWindows.Screened.Torque.overcast : {Λ : Preparation} →
  {l : ℕ} →
    («Y» : Λ.Course (VolumeCape.Dream.Nimbus l)) →
      («H» : Real.exp 1 ≤ Λ.x) →
        {i k : ℕ → ℕ} →
          {E : ℕ → Family (tent «Y» «H») → ℂ} →
            («G» : GroundExtension «Y» «H») →
              (s : ℕ) →
                Tilted.Ramp →
                  Dome (tent «Y» «H») →
                    (n : ℕ) →
                      ℕ → (a : ℕ) → Intermediate.Room (s + a) → Set (Pane (side «Y» (i («G».rows n)) (s + a))) → ℂ :=
fun {Λ} {l} «Y» «H» {i k} {E} «G» s P f n t a z U =>
  share «Y» (i («G».rows n)) t (s + a) (poseField P false (tractor «Y» «H» «G» s t n a z f))
    (Intermediate.temper (projectA «Y» (i («G».rows n)) t) (s + a) Λ.δ (s + a) z) Uᶜ
info: YM/SU5/May/TorqueCP.lean:77:0: def YM.CF.Buffered.Afterglow.Tower.FirstWindows.Screened.Torque.Sail : {Λ : Preparation} →
  {l : ℕ} →
    («Y» : Λ.Course (VolumeCape.Dream.Nimbus l)) →
      («H» : Real.exp 1 ≤ Λ.x) →
        {i k : ℕ → ℕ} → {E : ℕ → Family (tent «Y» «H») → ℂ} → GroundExtension «Y» «H» → Tilted.Ramp → ℝ≥0 → Prop :=
fun {Λ} {l} «Y» «H» {i k} {E} «G» P r =>
  ∀ (s : ℕ),
    ∀ f ∈ insideAt Λ l (tent «Y» «H») true (Ωₙ P r) s,
      ∀ (ε : ℝ),
        0 < ε →
          ∃ᶠ (n : ℕ) (d : ℕ) in atTop,
            ∃ a z U,
              Cred «Y» (i («G».rows n)) (k d) (s + a) z ∧
                Paid «Y» «H» «G» s P f n (k d) a z ε U ∧ -ε ≤ (overcast «Y» «H» «G» s P f n (k d) a z U).re
