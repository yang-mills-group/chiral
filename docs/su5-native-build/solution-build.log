  (U : Birthplace Y H V Q Qc j r C χ) (x : U.H.space),
  x ∈ bottom Y H V Q Qc j r C U ↔
    (∀ (t : NNReal), ((journey Y H V Q Qc j r C U).track t) x = x) ∧
