    (minimal : Tendsto (fun i => P.increment (c i) (r i)) atTop (𝓝 0) ∧ ∀ (i : ℕ), 0 < P.increment (c i) (r i))
    (state_price :
      ∀ (Z : Lead.Clan),
        Tendsto (fun i => ‖P.launchCost x (c i) (r i) Z G 0‖ / ↑(P.increment (c i) (r i))) atTop (𝓝 0) ∧
          Tendsto (fun i => ‖P.landingCost x (c i) (r i) Z F 0‖ / ↑(P.increment (c i) (r i))) atTop (𝓝 0))
    (telescope :
