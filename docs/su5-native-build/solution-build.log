                  (mul_pos (mul_pos (mul_pos (inv_pos_of_pos ht) (pow_pos (inv_pos_of_pos ht) l)) p)
                    (pow_pos (inv_pos_of_pos (Nat.cast_pos'.mpr k)) l))))
