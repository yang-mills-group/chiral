info: YM/SU5/Relativistic/Bailout.lean:38:0: @YM.CF.Papyrus.GaugeFlux.arc_toll : ∀ {K : YM.Pressure.Teller YM.CF.SU.group} {R : YM.RG.Patch}
  {L : YM.Precision.ChartRatio YM.CF.SU.group} (V : YM.CF.Vale.Grace K R L) {ε : ℝ},
  0 < ε →
    ∀ᶠ (x : ℝ) in Filter.atTop,
      ∀ {C N : YM.Lattice.Side} (e : ↑N = ↑C * ↑R.L) (i : ℕ) (M : YM.CF.Forge.Monk YM.CF.SU.group (V.L.op i e)),
        YM.CF.Newt.Cert R K (V.L.op i e) (V.L.mint i e) x →
          have Z := YM.CF.Corne.arcD (V.L.mint i e) x M;
          have S := V.L.op i e;
          |Z -
                -(1 / 2) *
                  (Real.log (YM.CF.Papyrus.GaugeFlux.costDet YM.CF.SU.group (V.L.H i) N) +
                      ↑(Fintype.card (YM.CF.Papyrus.GaugeFlux.Ink YM.CF.SU.group C)) * Real.log S.kernel.penalty -
                    Real.log (YM.CF.Papyrus.GaugeFlux.costDet YM.CF.SU.group (V.L.H (i + 1)) C))| ≤
            ε * ↑(Fintype.card (YM.Lattice.Site N))
