constructor:
  YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Spine.SixZoom.mk {P : Spine} {x : P.Spectrum0 3} {c r : ℕ → ℕ}
    (v0 :
      ∀ (Z : Window.Family) (s n : ℕ),
        P.birthCloud x Z s n =
          (P.wealth 3 ((P.otherSpectrum 3 3) x)) (P.viewF 3 ((P.otherSpectrum 3 3) x) s ⋯) -
            (P.sixM x s) (P.stockS Z (P.flash n)) • P.heaven 3 ((P.otherSpectrum 3 3) x))
    (shrinking : Tendsto (fun i => P.dew (c i) (r i)) atTop (𝓝 0)) (positive : ∀ (i : ℕ), 0 < P.dew (c i) (r i))
    (integrals :
      ∀ {F : ℕ → E4 → ℂ} {f : E4 → ℂ},
        HalfLimit F f →
          Tendsto (fun i => P.zoomBill x (c i) (r i) (F i)) atTop
            (𝓝 (Matrix.diagonal fun Z => ∫ (p : E4), f p ∂↑(promenade Z))))
    (bands :
      ∀ (V : Set E4),
        IsOpen V →
          (Mink.inside ∩ V).Nonempty → ∃ d, 0 < d ∧ ∀ᶠ (i : ℕ) in atTop, d • 1 ≤ P.windowCharge x (c i) (r i) V) :
    P.SixZoom x c r
