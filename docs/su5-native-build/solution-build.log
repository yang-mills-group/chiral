ℹ [18520/18714] Replayed ReviewSU5ReconstructionBounds
info: ReviewSU5ReconstructionBounds.lean:3:0: YM.CF.Py.Rate.LocalLimit.Papal.atlas_progress : ∀ (ε η : ℝ),
  0 < η →
    ∀ (U : YM.CF.Py.Rate.LocalLimit.Supplier),
      ∃ P l Z,
        ε < P.x ∧
          P.d ≤ η ∧
            YM.CF.Py.Rate.LocalLimit.decorate U P l Z ≤ P.h ∧
              P.nominated (YM.CF.VolumeCape.Dream.Nimbus l) ∧
                ∃ (H : Real.exp 1 ≤ P.x),
                  ∃ Y,
                    (∃ z, YM.CF.Py.Rate.Usable P.V P.W P.J P.N0 z P.delay Y.meter) ∧
                      (∀ (i k : ℕ), YM.CF.Py.Rate.Parcel.Prepared P.P P.delay ((Y.voyage i).X k)) ∧
                        (∀ (i j : ℕ),
                            YM.CF.Buffered.Advance.LoomLaw ((Y.voyage i).CapeT j)
                              (YM.SU5.FiniteGaugeData.Audit1102.lawRadius (YM.CF.VolumeCape.Dream.plot l).C)) ∧
                          ∃ q d w C,
                            YM.CF.Py.Rate.LocalLimit.Papal.Korn Y H q d w C Z ∧
                              ∃ a b I E L B T t,
                                ∃ (D : YM.CF.Buffered.Afterglow.Tapestry.Fashion Y H a b I E L B T t),
                                  YM.CF.Buffered.Afterglow.Tapestry.SeasonCert Y H D ∧
                                    ∃ G c P',
                                      (∀ (j : YM.Axis),
                                          ∃ room, YM.CF.Py.Rate.LocalLimit.Papal.mixed_in_ground Y H ⋯ G j room q d w) ∧
                                        YM.CF.Buffered.Afterglow.Tower.Selected.Issued Y H ⋯ ⋯ ⋯ 0 false (c 0) P' ∧
                                          (∀ (j : ℕ)
                                              (F :
                                                YM.CF.Buffered.Afterglow.Tower.Selected.Marks
                                                  (YM.CF.Buffered.Afterglow.Journey.tent Y H) false),
                                              ∫ (x : P'.X),
                                                  YM.CF.Buffered.Afterglow.Tower.Selected.response Y H ⋯ j ⋯ ⋯ 0 false
                                                    (c 0) (P'.character x) F ∂P'.μ =
                                                E j ↑F) ∧
                                            ∃ s ζ f f' x,
                                              0 < ζ ∧
