info: YM/SU5/Selected/VIIA.lean:29:0: @checkpoint : ∀ {c f : YM.Lattice.Side} {S : YM.RG.StepData c f} {G : YM.Gauge} (F : YM.Tree.Forest S.ratio)
  (T : YM.Pressure.Tube G S) (K : YM.Precision.Bed) (q : S.Choices) {σ E X D u : ℝ},
  T.up.Bounds T.high σ E D →
    S.patch.Branches S.kernel G →
      YM.Precision.Attached K T.up →
        YM.Precision.Floor K T.high f X u →
          YM.Bid.Sworn K f G →
            ∀ (x : ℝ),
              YM.Bid.Larger S →
                0 < X →
                  ∀ (θ : ℝ),
                    0 ≤ θ →
                      θ < 1 →
                        rate_ell σ E (YM.Pressure.Stores.till x) / T.high.direct ≤ θ ^ 2 →
                          have B := YM.FreeResolvent.treeMatrix G S F K.metric;
                          have C :=
                            Matrix.det (YM.CF.Neige.baseX T x (YM.AnalyticBridge.LocalGaussianLaws.bareStores S) F q 1);
                          have D := B.det;
                          0 < D ∧
                            0 < C ∧
                              2 * ↑(Fintype.card (YM.Precision.Key F G)) * Real.log (1 - θ) ≤ Real.log C - Real.log D ∧
                                Real.log C - Real.log D ≤ 2 * ↑(Fintype.card (YM.Precision.Key F G)) * Real.log (1 + θ)
