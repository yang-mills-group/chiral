  (A : ℕ → P.Apron) {FaY : P.Nib 3 (P.advocate 3 x 3)} {CaY : MH (P.ManyF 3 (P.advocate 3 x 3))},
  P.Iguana 3 (P.advocate 3 x 3) FaY A → P.Bought 3 (P.advocate 3 x 3) CaY A → P.Truth 3 (P.advocate 3 x 3) FaY CaY :=
fun P x A {FaY} {CaY} i b =>
  Exists.casesOn b fun k h =>
    And.casesOn h fun g t =>
      {
        translation := fun u v s z =>
          Eq.mpr (id (congrArg (fun _a => FaY ↑u ↑v = _a) (Eq.symm (t.translation u v s z))))
