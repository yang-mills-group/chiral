  {vacuum : process.Spectrum0 3} {layers : NSF.Boundary.Waves (roles.RadianceVU stress)}
  {response : NSF.Boundary.Surface (roles.RadianceVU stress)} {model : roles.GlowVU stress vacuum ⋯ layers response}
  (f g : Test4) (m τ : ℂ) (q : (roles.RadianceVU stress).Union) (A : Axis → (roles.RadianceVU stress).Union),
  Fields.causal f g →
    Commute (m • (model.system.operators.field q) f)
      (τ • ∑ j, (model.system.operators.field (A j)) ((takeDerivative j) g))
