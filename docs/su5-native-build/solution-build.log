info: YM/SU5/Selected/V.lean:48:0: @survey : ∀ {Λ : YM.CF.Py.Rate.LocalLimit.Preparation} {l : ℕ} (Y : Λ.Course (YM.CF.VolumeCape.Dream.Nimbus l))
  (H : Real.exp 1 ≤ Λ.x) {i k : ℕ → ℕ}
  {I : ℕ → YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) → ℕ → ℂ}
  {E : ℕ → YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) → ℂ}
  (V : YM.CF.Buffered.Afterglow.Journey.Universal Y H i k I E)
  {D :
    ℕ →
      YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H) →
        YM.CF.Buffered.Family (YM.CF.Buffered.Afterglow.Journey.tent Y H)}
  {a b : ℕ → ℕ} (Q : YM.CF.Buffered.Afterglow.Tower.Coherent Y H D a b) (Qc : Clipped Y H (i ∘ a) (k ∘ b))
  (C : (j : YM.Axis) → YM.CF.Buffered.Afterglow.Tower.Arena Y H Q.circuit j 0 false)
  (Ψ : Horizon Y H V Q Qc 3 false (C 3)),
  Law Y H V Q Qc 3 false (C 3) Ψ →
    ∀ {X : YM.CF.Buffered.Afterglow.Tapestry.Rack Λ l} {Z₀ : YM.CF.Buffered.Afterglow.Tapestry.Clay Λ l},
      YM.CF.Buffered.Afterglow.Tapestry.Exhibition Y H i k I E X Z₀ →
        ∀ {A : Mezz} {b' v' w' : ℕ} {C₁ δ ε Γ : ℝ} {G F : YM.CF.Crest.Airy.Coast → YM.CF.Crest.Airy.Wq A.marks}
          (Δ : Delay Y H b' v' δ Γ C₁ ε A w' G F) {q d w : ℕ} {C₀ T₀ : ℝ},
          Council.Choir Y H q d w C₀ T₀ Γ →
            10000 ≤ Γ →
              ∀ (u : ℕ)
                (V' :
                  (v : YM.Axis) →
                    (i_1 : (emigrant Y H V Q Qc 3 false (C 3) Ψ v (C v)).X) →
                      Birthplace Y H V Q Qc v false (C v)
                        ((emigrant Y H V Q Qc 3 false (C 3) Ψ v (C v)).character i_1)),
                ∃ F' F₁ s c c' x,
                  u ≤ s ∧
                    extremeJoint Y H Q false (marked Y H V Q Qc 3 false (C 3) (Ψ.character x)) ∧
                      YM.CF.Buffered.Afterglow.Tapestry.printedHere Λ l s A.Broad
                          (YM.CF.Buffered.Afterglow.Tapestry.cabin ↑c') ∧
                        ∀ (v : YM.Axis),
                          LoneVac Y H V Q Qc v false (C v) (V' v x) ∧
                            Law Y H V Q Qc v false (C v) (emigrant Y H V Q Qc 3 false (C 3) Ψ v (C v)) ∧
                              marked Y H V Q Qc v false (C v)
                                    ((emigrant Y H V Q Qc 3 false (C 3) Ψ v (C v)).character x) =
                                  marked Y H V Q Qc 3 false (C 3) (Ψ.character x) ∧
                                (∀ (z : YM.CF.SU.Slot),
                                    Witness Y H V Q Qc v (C v) (escort Y H V Q Qc 3 false (C 3) v (C v) (Ψ.character x))
                                      (F' z) z s
                                      (YM.CF.Pannier.Chancel.Sen
                                        (YM.CF.Pannier.Chancel.Survival.camp (YM.CF.Pannier.Chancel.payout d q w))
                                        (YM.CF.Pannier.Chancel.payout d q w))
                                      (YM.CF.Pannier.Chancel.booty
                                        (YM.CF.Pannier.Chancel.Survival.camp (YM.CF.Pannier.Chancel.payout d q w)) d q)
                                      (YM.CF.Buffered.Afterglow.Tapestry.cabin ↑c) (1 / 2)) ∧
                                  ∀ (z : YM.CF.Window.Family),
                                    ‖E s
                                            (YM.CF.Buffered.Afterglow.Tower.mirror
                                                (YM.CF.Buffered.Afterglow.Journey.tent Y H) 3 0
                                                ↑(Sermon.solitude A (YM.CF.Buffered.Afterglow.Journey.tent Y H)
                                                    (Delay.stationed Y H Δ) (F₁ z)) *
                                              ↑(Sermon.solitude A (YM.CF.Buffered.Afterglow.Journey.tent Y H)
                                                  (Delay.stationed Y H Δ) (F₁ z)))‖ ≤
                                        3 * Real.exp (1 - Γ) ∧
                                      ‖E s
                                              ↑(Sermon.solitude A (YM.CF.Buffered.Afterglow.Journey.tent Y H)
                                                  (Delay.stationed Y H Δ) (F₁ z))‖ <
                                          1 / 2 ∧
                                        ‖phaseRead Y H V Q Qc v (C v)
                                              (escort Y H V Q Qc 3 false (C 3) v (C v) (Ψ.character x)) s
                                              ↑(Sermon.solitude A (YM.CF.Buffered.Afterglow.Journey.tent Y H)
                                                  (Delay.stationed Y H Δ) (F₁ z))‖ <
                                          1 / 2
