  YM.CF.Buffered.Afterglow.Tower.VacuumSelection.Resolving.Tuned P f β →
    ∀ {A : ℝ},
      0 < A →
        ∀ {K : P.Register} {M : ℕ} {E : ℝ},
          P.PreparedInvestment K E M →
            ∀ (U : J → YM.Stationary.Gaia),
              (∀ (i : J), YM.CF.Py.Rate.LocalLimit.Preparation.Yoke.Appoint P.par A (fun s => u s i) (U i)) →
                (∀ (i j : J), U i = U j → ∀ᶠ (s : ℕ) in Filter.atTop, u s i = u s j) →
                  List.Pairwise (fun i j => U i ≠ U j) L →
                    ∀ (n : ℕ),
                      (∀ (i : J), 0 < (pathUp U P.par n i).ofLp 3) →
                        have v := fun s =>
                          (P.halfShift 3 ↑(YM.CF.Py.Rate.LocalLimit.Preparation.Yoke.Shuttle.kroll P.par A n s))
                            (letterTest L D P s r (YM.CF.Py.Rate.LocalLimit.Preparation.Yoke.Jewel.κFix β s) A m (u s));
